@namespace LoanServicingSystem.Components.Pages
@using LoanServicingSystem.Components.Shared

<div class="space-y-5">

    <!-- ========================================= -->
    <!-- Dashboard Header -->
    <!-- ========================================= -->

    <DashboardHeader OnRefresh="ReloadDashboard"
                     Title="Loan Officer" />

    <!-- ========================================= -->
    <!-- Dashboard Overview -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Left Panel -->

        <div class="md:col-span-2 flex flex-col gap-6">

            <!-- KPI Cards -->

            <div class="grid grid-cols-2 gap-4">

                <StatCard IsLoading="@IsLoading"
                          Title="Applications"
                          Value="@Dashboard.TotalApplications.ToString()"
                          SubTitle="Total Applications">

                    <Icon>📄</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Pending"
                          Value="@Dashboard.PendingApprovalCount.ToString()"
                          SubTitle="Awaiting Approval">

                    <Icon>⏳</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Approved"
                          Value="@Dashboard.ApprovedCount.ToString()"
                          SubTitle="Approved">

                    <Icon>✅</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Rejected"
                          Value="@Dashboard.RejectedCount.ToString()"
                          SubTitle="Rejected">

                    <Icon>❌</Icon>

                </StatCard>

            </div>

            <!-- Quick Actions -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 w-full">
                <QuickActions Actions="QuickActionsList" />
            </div>
            

        </div>

        <!-- Right Panel -->

        <div class="md:col-span-1 flex flex-col gap-6">

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 h-full flex flex-col gap-6">
                <div class="flex-1">

                    <div class="flex flex-col w-full h-full">

                        <div class="flex-grow relative w-full h-full">
                            <CollectionTrendChart Data="Dashboard.WeeklyApplications" />
                        </div>

                    </div>

                </div>

            </div>
            <div class="flex-1">

                <div class="flex flex-col items-center w-full h-full">

                    <div class="flex-grow relative w-full h-full">
                        <LoanStatusChart Data="Dashboard.ApplicationStatus" />
                    </div>

                </div>

            </div>

           

        </div>

    </div>

    <!-- ========================================= -->
    <!-- Data Tables -->
    <!-- ========================================= -->

    <RecentLoansTable Title="My Applications"
                      Loans="Dashboard.MyApplications" />

    <RecentLoansTable Title="Pending Approvals"
                      Loans="Dashboard.PendingApprovals" />

</div>