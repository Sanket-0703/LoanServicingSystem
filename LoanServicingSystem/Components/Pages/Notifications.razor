@page "/notifications"
@namespace LoanServicingSystem.Components.Pages
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Notifications - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">

    <div>

        <h2 class="text-2xl font-bold text-slate-800">
            Notification Center
        </h2>

        <p class="text-sm text-slate-500 mt-1">
            View all recent system notifications and activity.
        </p>

    </div>

    <button @onclick="MarkAllAsRead"
            class="px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition">

        Mark All Read

    </button>

</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

    @if (IsLoading)
    {
        <div class="py-16 text-center text-slate-500">

            Loading notifications...

        </div>
    }
    else if (!NotificationList.Any())
    {
        <div class="py-16 text-center">

            <div class="text-5xl mb-3">
                🔔
            </div>

            <h3 class="text-lg font-semibold text-slate-700">

                No Notifications

            </h3>

            <p class="text-sm text-slate-500 mt-2">

                You're all caught up.

            </p>

        </div>
    }
    else
    {
        @foreach (var notification in NotificationList)
        {
            <div class="border-b border-slate-100 p-5 flex justify-between items-center hover:bg-slate-50 transition">

                <div class="flex items-start gap-4">

                    <div class="mt-1">

                        @if (notification.IsRead)
                        {
                            <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                        }
                        else
                        {
                            <div class="w-3 h-3 rounded-full bg-indigo-600"></div>
                        }

                    </div>

                    <div>

                        <div class="font-medium text-slate-800">

                            @notification.Message

                        </div>

                        <div class="text-xs text-slate-500 mt-1">

                            @notification.CreatedAt.ToString("dd MMM yyyy hh:mm tt")

                        </div>

                    </div>

                </div>

                @if (!notification.IsRead)
                {
                    <button @onclick="() => MarkAsRead(notification.Id)"
                            class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">

                        Mark Read

                    </button>
                }

            </div>
        }
    }

</div>