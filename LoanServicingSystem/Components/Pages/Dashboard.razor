@page "/dashboard"
@layout MainLayout
@* @attribute [Authorize] *@

<PageTitle>Dashboard - Loan Servicing System</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Main Dashboard</h2>
    <p class="text-sm text-slate-500 mt-1">Your daily snapshot of loan health, collection metrics, and portfolio distribution.</p>
</div>

<!-- 1. Summary Cards (Active Loans, Overdue, Collections Today) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

    <!-- Active Loans -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Active Loans</p>
                <h3 class="text-3xl font-bold text-slate-900">$24.5M</h3>
            </div>
            <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
        </div>
        <div class="mt-4 flex items-center text-sm">
            <span class="text-emerald-600 font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                +4.2%
            </span>
            <span class="text-slate-400 ml-2">vs last month (1,204 accounts)</span>
        </div>
    </div>

    <!-- Overdue -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Overdue</p>
                <h3 class="text-3xl font-bold text-slate-900">$1.2M</h3>
            </div>
            <div class="p-2 bg-red-50 rounded-lg text-red-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <div class="mt-4 flex items-center text-sm">
            <span class="text-red-500 font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path></svg>
                +1.1%
            </span>
            <span class="text-slate-400 ml-2">NPA Risk (45 accounts)</span>
        </div>
    </div>

    <!-- Collections Today -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-1">Collections Today</p>
                <h3 class="text-3xl font-bold text-slate-900">$125.4K</h3>
            </div>
            <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <div class="mt-4 flex items-center text-sm">
            <div class="w-full bg-slate-100 rounded-full h-2 mr-3">
                <div class="bg-emerald-500 h-2 rounded-full" style="width: 82%"></div>
            </div>
            <span class="text-slate-500 font-medium whitespace-nowrap">82% to daily goal</span>
        </div>
    </div>
</div>

<!-- 2. Charts Section (Collections Trend & Product Distribution) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Collections Trend Chart -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-bold text-slate-800">Collections Trend</h3>
            <select class="bg-slate-50 border border-slate-200 text-slate-600 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 px-3 py-1.5 outline-none">
                <option>Last 7 Days</option>
                <option>This Month</option>
            </select>
        </div>

        <div class="h-64 flex items-end justify-between gap-2 sm:gap-4 pt-4">
            @foreach (var height in new[] { 40, 65, 45, 80, 55, 90, 75 })
            {
                <div class="w-full flex flex-col items-center group">
                    <div class="relative w-full bg-slate-100 rounded-t-md h-52 flex items-end">
                        <div class="w-full bg-indigo-500 hover:bg-indigo-600 transition-all rounded-t-md cursor-pointer" style="height: @(height)%"></div>
                        <div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs py-1 px-2 rounded pointer-events-none transition-opacity whitespace-nowrap">
                            $@(height * 1.5)K
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="flex justify-between text-xs text-slate-400 mt-3 px-2 font-medium">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
    </div>

    <!-- Product Distribution Chart -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-slate-800 mb-6">Product Distribution</h3>

        <div class="flex-1 flex flex-col items-center justify-center">
            <div class="relative w-40 h-40">
                <svg viewBox="0 0 36 36" class="w-full h-full transform -rotate-90">
                    <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="4" />
                    <path class="text-indigo-500" stroke-dasharray="45, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="4" />
                    <path class="text-blue-400" stroke-dasharray="30, 100" stroke-dashoffset="-45" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="4" />
                    <path class="text-emerald-400" stroke-dasharray="25, 100" stroke-dashoffset="-75" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="4" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-2xl font-bold text-slate-800">3</span>
                    <span class="text-xs text-slate-500">Products</span>
                </div>
            </div>

            <div class="w-full mt-8 space-y-3">
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-indigo-500 mr-2"></div>
                        <span class="text-slate-600 font-medium">Personal Loans</span>
                    </div>
                    <span class="text-slate-900 font-bold">45%</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-blue-400 mr-2"></div>
                        <span class="text-slate-600 font-medium">Vehicle Loans</span>
                    </div>
                    <span class="text-slate-900 font-bold">30%</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-emerald-400 mr-2"></div>
                        <span class="text-slate-600 font-medium">Micro-Business</span>
                    </div>
                    <span class="text-slate-900 font-bold">25%</span>
                </div>
            </div>
        </div>
    </div>
</div>