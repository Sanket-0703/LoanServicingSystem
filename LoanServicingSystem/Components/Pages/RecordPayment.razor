@page "/loans/{LoanId:guid}/payment"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer
@using LoanServicingSystem.Components.Shared

<PageTitle>Record Payment - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/loans/@LoanId" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Record Payment Transaction</h2>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Process incoming installment collections, adjust penalties, and update the general ledger.</p>
    </div>
</div>

@if (IsLoading)
{
    <div class="text-center py-12 text-slate-500">Loading payment workspace...</div>
}
else
{

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">

    <StatCard
        Title="Current Due"
        Value="@CurrentDueAmount.ToString("C")"
        SubTitle="Next EMI"
        IsLoading="@IsLoading"
        ValueColor="text-red-600">

        <Icon>💳</Icon>

    </StatCard>

    <StatCard
        Title="Payment Date"
        Value="@PaymentForm.PaymentDate.ToString("dd MMM")"
        SubTitle="Posting Date"
        IsLoading="@IsLoading"
        ValueColor="text-indigo-600">

        <Icon>📅</Icon>

    </StatCard>

    <StatCard
        Title="Payment Mode"
        Value="@PaymentForm.Mode"
        SubTitle="Collection Channel"
        IsLoading="@IsLoading">

        <Icon>🏦</Icon>

    </StatCard>

    <StatCard
        Title="Borrower"
        Value="@BorrowerName"
        SubTitle="@LoanNumber"
        IsLoading="@IsLoading">

        <Icon>👤</Icon>

    </StatCard>

</div>
    <EditForm Model="@PaymentForm" OnValidSubmit="@SubmitPaymentAsync">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl shadow-sm max-w-3xl mx-auto">
                @ErrorMessage
            </div>
        }

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 max-w-8xl mx-auto overflow-hidden">

            <!-- Account Summary Banner -->
            <div class="bg-slate-50 px-8 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Target Loan Account</span>
                    <div class="text-lg font-bold text-slate-900">@LoanNumber &bull; @BorrowerName</div>
                </div>
                <div class="text-left sm:text-right">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Current Due Amount</span>
                    <div class="text-lg font-bold text-indigo-600">@CurrentDueAmount.ToString("C")</div>
                </div>
            </div>

            <!-- Payment Form Fields -->
            <div class="p-8 space-y-6">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Payment Type</label>
                        <InputSelect @bind-Value="PaymentForm.PaymentType" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                            <option value="Standard EMI Installment">Regular EMI</option>
                            <option value="Late Penalty Clearance">Part Payment</option>
                            <option value="Lump-Sum Principal Prepayment">Penalty Payment</option>
                            <option value="Full Account Closure">Foreclosure</option>
                        </InputSelect>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Payment Amount ($) <span class="text-red-500">*</span></label>
                        <InputNumber @bind-Value="PaymentForm.Amount" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                    <!-- Payment Method -->

                    <div>

                        <label class="block text-sm font-medium text-slate-700 mb-1">

                            Payment Method

                        </label>

                        <InputSelect @bind-Value="PaymentForm.Mode"
                                     class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg">

                            <option>Bank Transfer</option>
                            <option>UPI</option>
                            <option>Cheque</option>
                            <option>Cash</option>

                        </InputSelect>

                    </div>

                    <!-- Payment Date -->

                    <div>

                        <label class="block text-sm font-medium text-slate-700 mb-1">

                            Payment Date

                        </label>

                        <InputDate @bind-Value="PaymentForm.PaymentDate"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg" />

                    </div>

                </div>

                <div class="grid grid-cols-1 gap-6 mt-6">

                    <div>

                        <label class="block text-sm font-medium text-slate-700 mb-1">

                            Transaction Reference / UTR #

                        </label>

                        <InputText @bind-Value="PaymentForm.ReferenceNumber"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg"
                                   placeholder="e.g. UTR992837410" />

                    </div>

                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Staff Notes / Remarks</label>
                    <InputTextArea @bind-Value="PaymentForm.Remarks" rows="3" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition resize-none" placeholder="Optional notes regarding receipt verification..."></InputTextArea>
                </div>

                <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-6">

                    <h3 class="font-semibold text-indigo-800 mb-5">

                        Payment Preview

                    </h3>

                    <div class="grid grid-cols-2 gap-5">

                        <div>

                            <p class="text-sm text-slate-500">

                                Amount Received

                            </p>

                            <p class="text-2xl font-bold text-indigo-700">

                                @PaymentForm.Amount.ToString("C")

                            </p>

                        </div>

                        <div>

                            <p class="text-sm text-slate-500">

                                Payment Type

                            </p>

                            <p class="font-semibold">

                                @PaymentForm.PaymentType

                            </p>

                        </div>

                        <div>

                            <p class="text-sm text-slate-500">

                                Mode

                            </p>

                            <p class="font-semibold">

                                @PaymentForm.Mode

                            </p>

                        </div>

                        <div>

                            <p class="text-sm text-slate-500">

                                Loan

                            </p>

                            <p class="font-semibold">

                                @LoanNumber

                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Form Actions Footer -->
            <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex justify-between items-center">
                <a href="/loans/@LoanId" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit" disabled="@IsSaving" class="px-6 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 disabled:opacity-50 transition shadow-sm flex items-center">
                    @if (IsSaving)
                    {
                        <span>Posting Payment...</span>
                    }
                    else
                    {
                        <span>Confirm & Post Payment</span>
                    }
                </button>
            </div>

        </div>
    </EditForm>
}