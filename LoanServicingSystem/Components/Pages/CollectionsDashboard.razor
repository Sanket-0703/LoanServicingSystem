@using LoanServicingSystem.Components.Shared
@namespace LoanServicingSystem.Components.Pages
<div class="space-y-5">

    <!-- ========================================= -->
    <!-- Dashboard Header -->
    <!-- ========================================= -->

    <DashboardHeader />

    <!-- ========================================= -->
    <!-- Dashboard Overview -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-5">

        <!-- ========================================= -->
        <!-- Left Section -->
        <!-- ========================================= -->

        <div class="xl:col-span-5 space-y-5">

            <!-- KPI Cards -->

            <div class="grid grid-cols-2 gap-4">

                <StatCard IsLoading="@IsLoading"
                          Title="Overdue Loans"
                          Value="@Dashboard.OverdueLoanCount.ToString()"
                          SubTitle="Past Due">

                    <Icon>📋</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Due Today"
                          Value="@Dashboard.DueTodayCount.ToString()"
                          SubTitle="EMIs Due">

                    <Icon>📅</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Collected Today"
                          Value="@Dashboard.CollectedToday.ToString("C0")"
                          SubTitle="Today's Collection">

                    <Icon>💰</Icon>

                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="Penalties"
                          Value="@Dashboard.UnpaidPenaltyAmount.ToString("C0")"
                          SubTitle="Unpaid Penalties">

                    <Icon>⚠️</Icon>

                </StatCard>

            </div>

            <!-- Quick Actions -->

            <QuickActions Actions="QuickActionsList" />

        </div>

        <!-- ========================================= -->
        <!-- Right Section -->
        <!-- ========================================= -->

        <div class="xl:col-span-7 space-y-5">

            <!-- Collection Trend Chart -->

            <CollectionTrendChart Data="Dashboard.CollectionTrend" />

            <!-- Overdue Status Chart -->

            <LoanStatusChart Data="Dashboard.OverdueStatus" />

        </div>

    </div>

    <!-- ========================================= -->
    <!-- Recent Activity -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">

        <!-- Overdue Loans -->

        <RecentLoansTable Title="Overdue Loans"
                          Loans="Dashboard.OverdueLoans" />

        <!-- Recent Payments -->

        <RecentPaymentsTable Title="Today's Payments"
                             Payments="Dashboard.RecentPayments" />

    </div>

</div>