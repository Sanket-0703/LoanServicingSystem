@page "/audit-trail"
@layout MainLayout
@* @attribute [Authorize(Roles = "Admin")] *@

<PageTitle>Audit Trail - Loan Servicing System</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">System Audit Trail</h2>
    <p class="text-sm text-slate-500 mt-1">Immutable log of security events, administrative actions, and critical financial postings.</p>
</div>

<!-- Filters -->
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col sm:flex-row gap-4">
    <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition" placeholder="Search audit logs by actor, action, or IP..." />
    </div>
    <div class="flex gap-4">
        <select class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg bg-slate-50">
            <option>All Severity Levels</option>
            <option>Info</option>
            <option>Warning</option>
            <option>Critical</option>
        </select>
    </div>
</div>

<!-- Audit Grid -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Timestamp</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Actor / User</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Event Action</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Severity</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">IP Address</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200 text-sm">
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500">Jul 23, 2026 09:14:22</td>
                    <td class="px-6 py-4 whitespace-nowrap font-medium text-slate-900">Sanket Admin (admin@sciforn.com)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-slate-700">Modified Loan Product PRD-01 Interest Rate</td>
                    <td class="px-6 py-4 whitespace-nowrap"><span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Info</span></td>
                    <td class="px-6 py-4 whitespace-nowrap font-mono text-xs text-slate-500">192.168.1.45</td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500">Jul 22, 2026 18:02:11</td>
                    <td class="px-6 py-4 whitespace-nowrap font-medium text-slate-900">Rahul Verma (rahul.verma@sciforn.com)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-slate-700">Executed Penalty Batch Overdue Run</td>
                    <td class="px-6 py-4 whitespace-nowrap"><span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-800">Warning</span></td>
                    <td class="px-6 py-4 whitespace-nowrap font-mono text-xs text-slate-500">192.168.1.88</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    // Audit log logic placeholder
}