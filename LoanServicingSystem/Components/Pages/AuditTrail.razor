@page "/audit-trail"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer

@using LoanServicingSystem.Components.Shared

<PageTitle>Audit Trail - Loan Servicing System</PageTitle>

<!-- ========================================= -->
<!-- Page Header -->
<!-- ========================================= -->

<div class="mb-6">

    <h2 class="text-2xl font-bold text-slate-800">
        System Audit Trail
    </h2>

    <p class="text-sm text-slate-500 mt-1">
        Track every database change across the platform for compliance, traceability and operational auditing.
    </p>

</div>

<!-- ========================================= -->
<!-- Summary Cards -->
<!-- ========================================= -->

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mt-6 mb-8">

    <StatCard Title="Total Changes"
              Value="@TotalChanges.ToString()"
              SubTitle="Audit Records"
              IsLoading="@IsLoading">

        <Icon>📋</Icon>

    </StatCard>

    <StatCard Title="Today's Changes"
              Value="@TodayChanges.ToString()"
              SubTitle="Current Day"
              IsLoading="@IsLoading"
              ValueColor="text-indigo-600"
              IconBackground="bg-indigo-100"
              IconColor="text-indigo-600">

        <Icon>📅</Icon>

    </StatCard>

    <StatCard Title="Inserted"
              Value="@InsertCount.ToString()"
              SubTitle="New Records"
              IsLoading="@IsLoading"
              ValueColor="text-emerald-600"
              IconBackground="bg-emerald-100"
              IconColor="text-emerald-600">

        <Icon>➕</Icon>

    </StatCard>

    <StatCard Title="Updated"
              Value="@UpdateCount.ToString()"
              SubTitle="Modified Records"
              IsLoading="@IsLoading"
              ValueColor="text-amber-600"
              IconBackground="bg-amber-100"
              IconColor="text-amber-600">

        <Icon>✏️</Icon>

    </StatCard>

</div>

<!-- ========================================= -->
<!-- Filters -->
<!-- ========================================= -->

<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- Search -->

        <div>

            <label class="block text-xs font-semibold text-slate-500 mb-2">
                Search
            </label>

            <input type="text"
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   placeholder="Search by user, module or record..."
                   class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" />

        </div>

        <!-- Module Filter -->

        <div>

            <label class="block text-xs font-semibold text-slate-500 mb-2">
                Module
            </label>

            <select @bind="SelectedModule"
                    class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm">

                <option>All Modules</option>
                <option>Loans</option>
                <option>Customers</option>
                <option>Payments</option>
                <option>Loan Products</option>
                <option>Disbursements</option>
                <option>Repayment Schedules</option>

            </select>

        </div>

        <!-- Change Type Filter -->

        <div>

            <label class="block text-xs font-semibold text-slate-500 mb-2">
                Change Type
            </label>

            <select @bind="SelectedChangeType"
                    class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm">

                <option>All Changes</option>
                <option>Insert</option>
                <option>Update</option>
                <option>Delete</option>

            </select>

        </div>

    </div>

</div>

<!-- ========================================= -->
<!-- Audit Trail Table -->
<!-- ========================================= -->

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">

    <div class="overflow-x-auto">

        <table class="min-w-full divide-y divide-slate-200">

            <!-- Table Header -->

            <thead class="bg-slate-50">

                <tr>

                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                        Changed On
                    </th>

                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                        Module
                    </th>

                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                        Record
                    </th>

                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                        Change Type
                    </th>

                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                        Changed By
                    </th>

                </tr>

            </thead>

            <!-- Table Body -->

            <tbody class="bg-white divide-y divide-slate-200">

                @if (IsLoading)
                {
                    <tr>

                        <td colspan="6" class="px-6 py-10 text-center text-slate-500">
                            Loading audit trail...
                        </td>

                    </tr>
                }
                else if (!FilteredLogs.Any())
                {
                    <tr>

                        <td colspan="6" class="px-6 py-10 text-center">

                            <div class="text-slate-400 text-lg mb-2">
                                📋
                            </div>

                            <div class="font-medium text-slate-700">
                                No audit records found
                            </div>

                            <div class="text-sm text-slate-500 mt-1">
                                Try changing the search or filter criteria.
                            </div>

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var log in FilteredLogs)
                    {
                        <tr class="hover:bg-slate-50 transition">

                            <!-- Date & Time -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <div class="text-sm font-medium text-slate-900">
                                    @log.ChangedOn.ToString("dd MMM yyyy")
                                </div>

                                <div class="text-xs text-slate-500">
                                    @log.ChangedOn.ToString("hh:mm tt")
                                </div>

                            </td>

                            <!-- Module -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <span class="inline-flex rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-700">
                                    @log.Module
                                </span>

                            </td>

                            <!-- Record Number -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <span class="font-mono text-sm text-slate-700">
                                    @log.RecordNumber
                                </span>

                            </td>

                            <!-- Change Type -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold @GetChangeTypeBadgeClass(log.ChangeType)">
                                    @log.ChangeType
                                </span>

                            </td>

                            <!-- Changed By -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <div class="font-medium text-slate-900">
                                    @log.ChangedBy
                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>