@page "/reports"
@layout MainLayout

<PageTitle>Reports Hub - Loan Servicing System</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Reports Hub</h2>
    <p class="text-sm text-slate-500 mt-1">Generate, view, and export compliance, financial, and portfolio performance reports.</p>
</div>

<!-- Report Categories Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

    <!-- NPA Report -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
            <div class="p-2 bg-red-50 text-red-600 rounded-lg w-fit mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-1">Non-Performing Assets (NPA)</h3>
            <p class="text-xs text-slate-500 mb-4">Regulatory breakdown of delinquent accounts flagged for asset classification.</p>
        </div>
        <button class="w-full py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition">
            Generate Report
        </button>
    </div>

    <!-- Interest Earned Report -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
            <div class="p-2 bg-emerald-50 text-emerald-600 rounded-lg w-fit mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-1">Interest Earned & Accrual</h3>
            <p class="text-xs text-slate-500 mb-4">Aggregated interest revenue accrued across active personal, vehicle, and business tiers.</p>
        </div>
        <button class="w-full py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition">
            Generate Report
        </button>
    </div>

    <!-- Collections Reconciliation -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
            <div class="p-2 bg-indigo-50 text-indigo-600 rounded-lg w-fit mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2m-6 9l2 2 4-4"></path></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-1">Daily Collection Reconciliation</h3>
            <p class="text-xs text-slate-500 mb-4">Transaction logs matching ledger payments against bank deposits for day-end closure.</p>
        </div>
        <button class="w-full py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm font-medium rounded-lg border border-slate-200 transition">
            Generate Report
        </button>
    </div>

</div>

<!-- Recent Exports Table -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-4">Recent Generated Exports</h3>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-slate-500">Report Name</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-500">Generated By</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-500">Timestamp</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-500">Format</th>
                    <th class="px-4 py-3 text-right font-semibold text-slate-500">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <tr>
                    <td class="px-4 py-3 font-medium text-slate-900">Monthly_NPA_Summary_July2026.csv</td>
                    <td class="px-4 py-3 text-slate-500">Sanket Admin</td>
                    <td class="px-4 py-3 text-slate-500">Jul 22, 2026 06:00 PM</td>
                    <td class="px-4 py-3"><span class="px-2 py-0.5 text-xs font-semibold rounded bg-slate-100 text-slate-700">CSV</span></td>
                    <td class="px-4 py-3 text-right font-medium"><a href="#" class="text-indigo-600 hover:text-indigo-900">Download</a></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-medium text-slate-900">Daily_Collection_Recon_Jul21.xlsx</td>
                    <td class="px-4 py-3 text-slate-500">Rahul Verma</td>
                    <td class="px-4 py-3 text-slate-500">Jul 21, 2026 08:30 PM</td>
                    <td class="px-4 py-3"><span class="px-2 py-0.5 text-xs font-semibold rounded bg-emerald-50 text-emerald-700">XLSX</span></td>
                    <td class="px-4 py-3 text-right font-medium"><a href="#" class="text-indigo-600 hover:text-indigo-900">Download</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

