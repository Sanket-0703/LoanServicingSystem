@page "/customers/new"
@page "/customers/{Id:int}"
@layout MainLayout

<PageTitle>Customer Profile - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/customers" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">@(Id.HasValue ? "Customer Profile & KYC" : "Register New Customer")</h2>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Capture and verify borrower identification, financial health, and KYC compliance.</p>
    </div>
    <div class="flex gap-3">
        <a href="/customers" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition">
            Cancel
        </a>
        <button type="button" @onclick="SaveCustomer" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
            Save Profile
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left Column: Personal & KYC Information Form -->
    <div class="lg:col-span-2 space-y-6">

        <!-- Basic Information Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 pb-2 border-b border-slate-100">Personal Information</h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="e.g. Aarav Patel" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
                    <input type="email" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="aarav@example.com" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="+91 98765 43210" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Date of Birth</label>
                    <input type="date" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" />
                </div>
            </div>
        </div>

        <!-- Regulatory & KYC Card -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 pb-2 border-b border-slate-100">KYC & Regulatory Details</h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">PAN Number</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm uppercase focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="ABCDE1234F" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Government ID / Aadhaar Reference</label>
                    <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="Enter 12-digit ID reference" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">KYC Verification Status</label>
                    <select class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 transition">
                        <option>Pending</option>
                        <option>Verified</option>
                        <option>Rejected</option>
                    </select>
                </div>
            </div>
        </div>

    </div>

    <!-- Right Column: Financial Profile & Risk Score -->
    <div class="space-y-6">

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-lg font-semibold text-slate-800 mb-4 pb-2 border-b border-slate-100">Financial Profile</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Monthly Income ($)</label>
                    <input type="number" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="5500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Credit Score</label>
                    <input type="number" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 focus:bg-white transition" placeholder="750" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Employment Type</label>
                    <select class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-slate-50 transition">
                        <option>Salaried</option>
                        <option>Self-Employed</option>
                        <option>Business Owner</option>
                        <option>Freelancer</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-6 text-indigo-900">
            <h4 class="font-semibold text-sm mb-1">Compliance Check</h4>
            <p class="text-xs text-indigo-700 leading-relaxed">Ensure all physical documents match uploaded records before approving KYC verification status.</p>
        </div>

    </div>

</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private void SaveCustomer()
    {
        // Placeholder save action
    }
}