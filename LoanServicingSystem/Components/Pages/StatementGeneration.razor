@page "/statements"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer
@using CoreData.Servicing
@using LoanServicingSystem.Components.Shared

<PageTitle>Statement Generation - Loan Servicing System</PageTitle>

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Statement Generation</h2>
    <p class="text-sm text-slate-500 mt-1">Generate and export official account statements for borrower verification and audit records.</p>
</div>

@if (IsLoadingLoans)
{
    <div class="text-center py-12 text-slate-500">Loading loan accounts...</div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    <StatCard Title="Outstanding"
                  Value="@(SelectedLoan?.Principal.ToString("C") ?? "$0")"
              SubTitle="Current Balance"
              IsLoading="@IsGenerating"
              ValueColor="text-red-600">

        <Icon>🏦</Icon>

    </StatCard>

    <StatCard Title="Principal"
                  Value="@(SelectedLoan?.Principal.ToString("C") ?? "$0")"
              SubTitle="Loan Amount"
              IsLoading="@IsGenerating"
              ValueColor="text-blue-600">

        <Icon>💰</Icon>

    </StatCard>

    <StatCard Title="Interest Rate"
                  Value="@(SelectedLoan?.InterestRate.ToString("0.00") + "%" ?? "0%")"
              SubTitle="Annual Rate"
              IsLoading="@IsGenerating"
              ValueColor="text-amber-600">

        <Icon>📈</Icon>

    </StatCard>

    <StatCard Title="Transactions"
                  Value="@TotalPayments.ToString()"
              SubTitle="Within Period"
              IsLoading="@IsGenerating"
              ValueColor="text-emerald-600">

        <Icon>📄</Icon>

    </StatCard>

</div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Statement Parameters Form -->
        <!-- Export Panel -->

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">

            <h3 class="text-lg font-bold text-slate-800 mb-6">
                Export Statement
            </h3>

            <div class="space-y-4">

                <div>

                    <label class="block text-sm font-medium text-slate-700 mb-2">
                        Select Loan Account
                    </label>

                    <select value="@SelectedLoanId"
                            @onchange="OnLoanChanged"
                            class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-slate-50">

                        @foreach (var loan in AvailableLoans)
                        {
                            <option value="@loan.Id">
                                @loan.LoanNumber (@loan.CustomerName)
                            </option>
                        }

                    </select>

                </div>

                <button @onclick="ExportStatement"
                        disabled="@IsGenerating"
                        class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold">

                    @if (IsGenerating)
                    {
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span>📊 Export Excel Statement</span>
                    }

                </button>

            </div>

        </div>

        <!-- Statement Preview Canvas -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-12 flex flex-col items-center justify-center">

            <div class="text-7xl mb-5">
                📊
            </div>

            <h2 class="text-3xl font-bold text-slate-800">
                Loan Statement Export
            </h2>

            <p class="mt-4 text-center text-slate-500 max-w-xl">

                Select a loan account from the left panel.

                Click

                <strong>Export Excel Statement</strong>

                to generate a professional Excel workbook containing

                Loan Summary,

                Payment History,

                and

                Repayment Schedule.

            </p>

        </div>

    </div>
}