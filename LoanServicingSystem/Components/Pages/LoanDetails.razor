@page "/loans/{Id:int}"
@layout MainLayout

<PageTitle>Loan Servicing Hub - Loan Servicing System</PageTitle>

<!-- Top Navigation & Actions Header -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <div class="flex items-center gap-3">
            <a href="/loans" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Loan Account #LN-2026-001</h2>
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Disbursed</span>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Borrower: <span class="font-medium text-slate-700">Aarav Patel</span> (CUST-8273) &bull; Product: <span class="font-medium text-slate-700">Personal Loan - Tier 1</span></p>
    </div>

    <div class="flex items-center gap-3">
        <button class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition shadow-sm">
            Apply Penalty
        </button>
        <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
            Record Payment
        </button>
    </div>
</div>

<!-- Quick Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Principal Balance</div>
        <div class="text-xl font-bold text-slate-900">$13,450.00</div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Next EMI Due</div>
        <div class="text-xl font-bold text-slate-900">$485.20</div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Due Date</div>
        <div class="text-xl font-bold text-slate-900">Aug 05, 2026</div>
    </div>
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Paid</div>
        <div class="text-xl font-bold text-emerald-600">$2,426.00</div>
    </div>
</div>

<!-- Tab Navigation -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="border-b border-slate-200 px-6 flex gap-8">
        <button @onclick='() => ActiveTab = "overview"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "overview" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            Overview Summary
        </button>
        <button @onclick='() => ActiveTab = "amortization"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "amortization" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            Amortization Schedule
        </button>
        <button @onclick='() => ActiveTab = "ledger"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "ledger" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            Transaction Ledger History
        </button>
    </div>

    <!-- Tab Contents -->
    <div class="p-6">
        @if (ActiveTab == "overview")
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <h3 class="font-semibold text-slate-800">Loan Terms Configuration</h3>
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-sm">
                        <div class="flex justify-between"><span class="text-slate-500">Approved Principal:</span> <span class="font-medium text-slate-900">$15,000.00</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Annual Interest Rate:</span> <span class="font-medium text-slate-900">12.5%</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Tenure Term:</span> <span class="font-medium text-slate-900">36 Months</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Processing Fee Paid:</span> <span class="font-medium text-slate-900">$150.00</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Disbursement Date:</span> <span class="font-medium text-slate-900">May 05, 2026</span></div>
                    </div>
                </div>

                <div class="space-y-4">
                    <h3 class="font-semibold text-slate-800">Account Health & Risk</h3>
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-sm">
                        <div class="flex justify-between"><span class="text-slate-500">Payment Consistency:</span> <span class="font-medium text-emerald-600">On Time (2/36 Paid)</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Days Past Due (DPD):</span> <span class="font-medium text-slate-900">0 Days</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Late Penalties Applied:</span> <span class="font-medium text-slate-900">$0.00</span></div>
                        <div class="flex justify-between"><span class="text-slate-500">Assigned Officer:</span> <span class="font-medium text-slate-900">Priya Sharma</span></div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == "amortization")
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-500">Installment #</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-500">Due Date</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">EMI Amount</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Principal</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Interest</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Balance</th>
                            <th class="px-4 py-3 text-center font-semibold text-slate-500">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <tr>
                            <td class="px-4 py-3 font-medium">1</td>
                            <td class="px-4 py-3 text-slate-500">Jun 05, 2026</td>
                            <td class="px-4 py-3 text-right font-medium">$485.20</td>
                            <td class="px-4 py-3 text-right text-slate-500">$328.70</td>
                            <td class="px-4 py-3 text-right text-slate-500">$156.50</td>
                            <td class="px-4 py-3 text-right text-slate-500">$14,671.30</td>
                            <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Paid</span></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium">2</td>
                            <td class="px-4 py-3 text-slate-500">Jul 05, 2026</td>
                            <td class="px-4 py-3 text-right font-medium">$485.20</td>
                            <td class="px-4 py-3 text-right text-slate-500">$332.13</td>
                            <td class="px-4 py-3 text-right text-slate-500">$153.07</td>
                            <td class="px-4 py-3 text-right text-slate-500">$14,339.17</td>
                            <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Paid</span></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium">3</td>
                            <td class="px-4 py-3 text-slate-500">Aug 05, 2026</td>
                            <td class="px-4 py-3 text-right font-medium">$485.20</td>
                            <td class="px-4 py-3 text-right text-slate-500">$335.60</td>
                            <td class="px-4 py-3 text-right text-slate-500">$149.60</td>
                            <td class="px-4 py-3 text-right text-slate-500">$14,003.57</td>
                            <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-100 text-amber-800">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else if (ActiveTab == "ledger")
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-500">Timestamp</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-500">Transaction Type</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Debit (-)</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Credit (+)</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-500">Running Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <tr>
                            <td class="px-4 py-3 text-slate-500">May 05, 2026 10:14 AM</td>
                            <td class="px-4 py-3 font-medium text-slate-900">Principal Disbursement</td>
                            <td class="px-4 py-3 text-right text-slate-900">$15,000.00</td>
                            <td class="px-4 py-3 text-right text-slate-400">-</td>
                            <td class="px-4 py-3 text-right font-medium">$15,000.00</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 text-slate-500">Jun 04, 2026 02:30 PM</td>
                            <td class="px-4 py-3 font-medium text-slate-900">EMI Payment Received</td>
                            <td class="px-4 py-3 text-right text-slate-400">-</td>
                            <td class="px-4 py-3 text-right text-emerald-600">$485.20</td>
                            <td class="px-4 py-3 text-right font-medium">$14,514.80</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private string ActiveTab = "overview";
}