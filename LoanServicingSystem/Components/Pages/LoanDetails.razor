@page "/loans/{Id:guid}"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer

<PageTitle>Loan Details - Loan Servicing System</PageTitle>

@if (IsLoading)
{
    <div class="text-center py-12 text-slate-500">Loading loan account details...</div>
}
else if (CurrentLoan == null)
{
    <div class="bg-red-50 border border-red-200 text-red-700 p-6 rounded-xl text-center">
        @(ErrorMessage ?? "Loan record could not be found.")
        <div class="mt-4">
            <a href="/loans" class="text-indigo-600 font-medium hover:underline">&larr; Return to Loan Directory</a>
        </div>
    </div>
}
else
{
    <!-- Top Navigation & Actions Header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <a href="/loans" class="text-slate-400 hover:text-slate-600 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </a>
                <h2 class="text-2xl font-bold text-slate-800">Loan Account #@CurrentLoan.LoanNumber</h2>
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full @GetStatusBadgeClass(CurrentLoan.Status)">@CurrentLoan.Status</span>
            </div>
            <p class="text-sm text-slate-500 mt-1 ml-8">Borrower: <span class="font-medium text-slate-700">@CurrentLoan.CustomerName</span> &bull; Product: <span class="font-medium text-slate-700">@CurrentLoan.ProductName</span></p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/loans/@CurrentLoan.Id/penalty" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition shadow-sm">
                Apply Penalty
            </a>
            <a href="/loans/@CurrentLoan.Id/payment" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
                Record Payment
            </a>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Principal Balance</div>
            <div class="text-xl font-bold text-slate-900">@PrincipalBalance.ToString("C")</div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Next EMI Due</div>
            <div class="text-xl font-bold text-slate-900">@(NextEmiAmount > 0 ? NextEmiAmount.ToString("C") : "$0.00")</div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Due Date</div>
            <div class="text-xl font-bold text-slate-900">@(NextEmiDueDate.HasValue ? NextEmiDueDate.Value.ToString("MMM dd, yyyy") : "Completed")</div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Paid</div>
            <div class="text-xl font-bold text-emerald-600">@TotalPaid.ToString("C")</div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="border-b border-slate-200 px-6 flex gap-8">
            <button @onclick='() => ActiveTab = "overview"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "overview" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
                Overview Summary
            </button>
            <button @onclick='() => ActiveTab = "amortization"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "amortization" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
                Amortization Schedule
            </button>
            <button @onclick='() => ActiveTab = "ledger"' class="py-4 text-sm font-semibold border-b-2 transition @(ActiveTab == "ledger" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
                Transaction Ledger History
            </button>
        </div>

        <!-- Tab Contents -->
        <div class="p-6">
            @if (ActiveTab == "overview")
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-4">
                        <h3 class="font-semibold text-slate-800">Loan Terms Configuration</h3>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-sm">
                            <div class="flex justify-between"><span class="text-slate-500">Approved Principal:</span> <span class="font-medium text-slate-900">@CurrentLoan.Principal.ToString("C")</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Annual Interest Rate:</span> <span class="font-medium text-slate-900">@CurrentLoan.InterestRate.ToString("0.00")%</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Tenure Term:</span> <span class="font-medium text-slate-900">@CurrentLoan.Tenure Months</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Repayment Frequency:</span> <span class="font-medium text-slate-900">@CurrentLoan.RepaymentFrequency</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Start Date:</span> <span class="font-medium text-slate-900">@(CurrentLoan.StartDate.HasValue ? CurrentLoan.StartDate.Value.ToString("MMM dd, yyyy") : "-")</span></div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <h3 class="font-semibold text-slate-800">Account Health & Risk</h3>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-sm">
                            <div class="flex justify-between"><span class="text-slate-500">Payment Consistency:</span> <span class="font-medium text-emerald-600">On Time (@PaidCount / @CurrentLoan.Tenure Paid)</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Days Past Due (DPD):</span> <span class="font-medium text-slate-900">0 Days</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Account Status:</span> <span class="font-medium text-slate-900">@CurrentLoan.Status</span></div>
                            <div class="flex justify-between"><span class="text-slate-500">Last Updated By:</span> <span class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(CurrentLoan.UpdatedBy) ? "System" : CurrentLoan.UpdatedBy)</span></div>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "amortization")
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500">Installment #</th>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500">Due Date</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">EMI Amount</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Principal</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Interest</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Balance</th>
                                <th class="px-4 py-3 text-center font-semibold text-slate-500">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            @if (!ScheduleItems.Any())
                            {
                                <tr>
                                    <td colspan="7" class="px-4 py-6 text-center text-slate-500">No amortization schedule found for this loan.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in ScheduleItems)
                                {
                                    <tr>
                                        <td class="px-4 py-3 font-medium">@item.EmiNo</td>
                                        <td class="px-4 py-3 text-slate-500">@item.DueDate.ToString("MMM dd, yyyy")</td>
                                        <td class="px-4 py-3 text-right font-medium">@((item.Principal + item.Interest).ToString("C"))</td>
                                        <td class="px-4 py-3 text-right text-slate-500">@item.Principal.ToString("C")</td>
                                        <td class="px-4 py-3 text-right text-slate-500">@item.Interest.ToString("C")</td>
                                        <td class="px-4 py-3 text-right text-slate-500">@item.Outstanding.ToString("C")</td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="px-2 py-0.5 text-xs font-semibold rounded-full @(item.Status == "Paid" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (ActiveTab == "ledger")
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500">Timestamp</th>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500">Transaction Type</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Debit (-)</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Credit (+)</th>
                                <th class="px-4 py-3 text-right font-semibold text-slate-500">Running Balance</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            @if (!LedgerItems.Any())
                            {
                                <tr>
                                    <td colspan="5" class="px-4 py-6 text-center text-slate-500">No transaction records found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var tx in LedgerItems)
                                {
                                    <tr>
                                        <td class="px-4 py-3 text-slate-500">@tx.Timestamp.ToString("MMM dd, yyyy HH:mm tt")</td>
                                        <td class="px-4 py-3 font-medium text-slate-900">@tx.TransactionType</td>
                                        <td class="px-4 py-3 text-right text-slate-900">@(tx.Debit.HasValue ? tx.Debit.Value.ToString("C") : "-")</td>
                                        <td class="px-4 py-3 text-right text-emerald-600">@(tx.Credit.HasValue ? tx.Credit.Value.ToString("C") : "-")</td>
                                        <td class="px-4 py-3 text-right font-medium">@tx.RunningBalance.ToString("C")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}