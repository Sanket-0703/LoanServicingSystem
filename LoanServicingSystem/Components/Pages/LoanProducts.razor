@page "/loan-products"
@attribute [Authorize(Roles = "Admin")]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer
@using LoanServicingSystem.Components.Shared

<PageTitle>Loan Products Configuration - Loan Servicing System</PageTitle>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

    <div>

        <h2 class="text-3xl font-bold text-slate-800">
            Loan Products
        </h2>

        <p class="mt-1 text-sm text-slate-500">
            Configure and manage loan product templates, interest rates, tenure and processing fees.
        </p>

    </div>

    <button @onclick="HandleCreateProduct"
            class="inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2.5 text-white font-medium shadow-sm hover:bg-indigo-700 transition">

        <svg class="w-5 h-5 mr-2"
             fill="none"
             stroke="currentColor"
             viewBox="0 0 24 24">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4" />

        </svg>

        Create Product

    </button>

</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    <StatCard Title="Products"
              Value="@TotalProducts.ToString()"
              SubTitle="Configured Templates"
              IsLoading="@IsLoading">

        <Icon>📦</Icon>

    </StatCard>

    <StatCard Title="Avg Interest"
              Value="@($"{AverageInterest}%")"
              SubTitle="Annual Rate"
              IsLoading="@IsLoading"
              ValueColor="text-blue-600"
              IconBackground="bg-blue-100"
              IconColor="text-blue-600">

        <Icon>📈</Icon>

    </StatCard>

    <StatCard Title="Max Tenure"
              Value="@($"{MaximumTenure} M")"
              SubTitle="Longest Duration"
              IsLoading="@IsLoading"
              ValueColor="text-emerald-600"
              IconBackground="bg-emerald-100"
              IconColor="text-emerald-600">

        <Icon>📅</Icon>

    </StatCard>

    <StatCard Title="Avg Fee"
              Value="@AverageFee.ToString("C")"
              SubTitle="Processing Fee"
              IsLoading="@IsLoading"
              ValueColor="text-amber-600"
              IconBackground="bg-amber-100"
              IconColor="text-amber-600">

        <Icon>💰</Icon>

    </StatCard>

</div>

<!-- Products Grid -->
@if (IsLoading)
{
    <div class="text-center py-12 text-slate-500">Loading loan product configurations...</div>
}
else if (!AllProducts.Any())
{
    <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 shadow-sm">
        <p class="text-slate-500 text-sm">No loan product templates found. Click "Create Product Template" to begin.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        @foreach (var product in AllProducts)
        {
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-6 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-start mb-4">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Configured</span>
                    </div>
                    <div class="flex items-center gap-3 mb-4">

                        <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center text-2xl">

                            @GetProductIcon(product.Name)

                        </div>

                        <div>

                            <h3 class="text-lg font-bold text-slate-900">

                                @product.Name

                            </h3>

                            <p class="text-xs text-slate-500">

                                Loan Product Template

                            </p>

                        </div>

                    </div>
                    <p class="text-xs text-slate-500 mb-4 h-10 overflow-hidden">
                        @(string.IsNullOrWhiteSpace(product.PenaltyRules) ? "No penalty rules defined." : product.PenaltyRules)
                    </p>

                    <div class="grid grid-cols-3 gap-3 mt-5">

                        <div class="bg-slate-50 rounded-lg p-3 text-center">

                            <p class="text-xl font-bold text-indigo-600">

                                @product.InterestRate%

                            </p>

                            <p class="text-xs text-slate-500">

                                Interest

                            </p>

                        </div>

                        <div class="bg-slate-50 rounded-lg p-3 text-center">

                            <p class="text-xl font-bold text-emerald-600">

                                @product.TenureMonths

                            </p>

                            <p class="text-xs text-slate-500">

                                Months

                            </p>

                        </div>

                        <div class="bg-slate-50 rounded-lg p-3 text-center">

                            <p class="text-xl font-bold text-amber-600">

                                @product.ProcessingFee?.ToString("C0")

                            </p>

                            <p class="text-xs text-slate-500">

                                Fee

                            </p>

                        </div>

                    </div>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex justify-end gap-2">
                    <button @onclick="() => HandleConfigureProduct(product.Id)" class="px-3 py-1.5 text-xs font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition">⚙ Configure</button>
                </div>
            </div>
        }
    </div>
}

<!-- Centered Modal for Add / Edit Product -->
@if (ShowModal)
{
    <!-- Backdrop -->
    <div class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm transition-opacity duration-300 ease-in-out"></div>

    <!-- Modal Placement -->
    <div class="fixed inset-0 z-50 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">

            <!-- Modal Panel -->
            <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">

                <!-- Header -->
                <div class="flex items-center justify-between bg-slate-50 border-b border-slate-200 px-6 py-4">
                    <h3 class="text-lg font-bold text-slate-800">@(IsUpdate ? "Configure Product Template" : "Create Product Template")</h3>
                    <button type="button" class="rounded-full p-2 text-slate-400 hover:bg-slate-200 hover:text-slate-600 transition-colors duration-200" @onclick="CloseModal">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ModalErrorMessage))
                {
                    <div class="mx-6 mt-4 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg">
                        @ModalErrorMessage
                    </div>
                }

               
                <!-- Form Content -->
                <div class="p-6">
                    <EditForm Model="@ActiveProduct" OnValidSubmit="@SaveProductAsync">
                        <div class="space-y-4">

                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Product Name <span class="text-red-500">*</span></label>
                                <InputText @bind-Value="ActiveProduct.Name" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" placeholder="e.g. Education Advance" />
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Interest Rate (%/yr) <span class="text-red-500">*</span></label>
                                    <InputNumber @bind-Value="ActiveProduct.InterestRate" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Tenure (Months) <span class="text-red-500">*</span></label>
                                    <InputNumber @bind-Value="ActiveProduct.TenureMonths" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Processing Fee <span class="text-red-500">*</span></label>
                                <InputNumber @bind-Value="ActiveProduct.ProcessingFee" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Penalty Rules</label>
                                <InputTextArea @bind-Value="ActiveProduct.PenaltyRules" rows="2" class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 resize-none" placeholder="Enter penalty rules for late payments" />
                            </div>

                        </div>

                        <!-- Footer Actions MOVED INSIDE the EditForm -->
                        <div class="border-t border-slate-200 bg-slate-50 px-6 py-4 mt-6 -mx-6 -mb-6 rounded-b-xl">
                            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                                <button type="button" class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition shadow-sm" @onclick="CloseModal">
                                    Cancel
                                </button>
                                <!-- CHANGED to type="submit", REMOVED @onclick -->
                                <button type="submit" disabled="@IsSaving" class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 transition shadow-sm">
                                    @if (IsSaving)
                                    {
                                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(IsUpdate ? "Update Template" : "Save Template")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}