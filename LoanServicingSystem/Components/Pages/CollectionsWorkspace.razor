@page "/collections"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer
@using LoanServicingSystem.Components.Shared

<PageTitle>Collections Workspace - Loan Servicing System</PageTitle>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Collections & Overdue Workspace</h2>
        <p class="text-sm text-slate-500 mt-1">Track distressed assets, manage late penalties, and review accounts past due.</p>
    </div>
    <div class="flex gap-3">

        <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition">

            Send Reminders

        </button>

        <button class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700 transition">

            Penalty Engine

        </button>

    </div>
</div>

@if (IsLoading)
{
    <div class="py-20 flex justify-center text-slate-400">Loading distressed assets...</div>
}
else
{
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">

        <StatCard Title="Overdue Portfolio"
                  Value="@WorkspaceData.TotalOverduePortfolio.ToString("C0")"
                  SubTitle="Total Outstanding"
                  IsLoading="@IsLoading"
                  ValueColor="text-red-600">

            <Icon>⚠️</Icon>

        </StatCard>

        <StatCard Title="30+ DPD"
                  Value="@WorkspaceData.Dpd30PlusAccounts.ToString()"
                  SubTitle="High Risk Accounts"
                  IsLoading="@IsLoading"
                  ValueColor="text-rose-600">

            <Icon>🚨</Icon>

        </StatCard>

        <StatCard Title="Recovered Today"
                  Value="@WorkspaceData.RecoveredToday.ToString("C0")"
                  SubTitle="Collections"
                  IsLoading="@IsLoading"
                  ValueColor="text-emerald-600">

            <Icon>💰</Icon>

        </StatCard>

        <StatCard Title="Cases"
                  Value="@WorkspaceData.DelinquentAccounts.Count.ToString()"
                  SubTitle="Open Collection Queue"
                  IsLoading="@IsLoading"
                  ValueColor="text-indigo-600">

            <Icon>📋</Icon>

        </StatCard>

    </div>

    <!-- Overdue Grid -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <div class="mb-5 flex justify-between items-center">

                <div>

                    <h3 class="text-lg font-semibold text-slate-800">

                        Collection Queue

                    </h3>

                    <p class="text-sm text-slate-500">

                        Accounts requiring collection follow-up

                    </p>

                </div>

                <span class="px-3 py-2 rounded-lg bg-slate-100 text-sm font-semibold">

                    @WorkspaceData.DelinquentAccounts.Count Active Cases

                </span>

            </div>
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Loan</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Days Past Due (DPD)</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Overdue Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Late Charges</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Collection Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200 text-sm">
                    @if (!WorkspaceData.DelinquentAccounts.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                                <span class="block text-emerald-600 font-medium mb-1">Fantastic!</span>
                                All active loans are currently up to date.
                                No collection activities are pending.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in WorkspaceData.DelinquentAccounts)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap">

                                    <div class="font-bold text-slate-900">
                                        @account.LoanNumber
                                    </div>

                                    <div class="text-xs text-slate-500">
                                        @account.BorrowerName
                                        (@account.CustomerId.ToString().Substring(0, 8).ToUpper())
                                    </div>

                                    <div class="mt-2">

                                        @if (account.DaysPastDue >= 90)
                                        {
                                            <span class="inline-flex rounded-full bg-rose-100 px-2 py-1 text-xs font-semibold text-rose-700">
                                                NPA
                                            </span>
                                        }
                                        else if (account.DaysPastDue >= 30)
                                        {
                                            <span class="inline-flex rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-700">
                                                High Risk
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-700">
                                                Early Delinquency
                                            </span>
                                        }

                                    </div>

                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full @GetDpdBadgeClass(account.DaysPastDue)">
                                        @account.DaysPastDue Days DPD
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap font-bold text-slate-900">@account.OverdueAmount.ToString("C")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-red-600 font-medium">@account.PenaltyDue.ToString("C")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                                    <a href="/loans/@account.LoanId" class="text-indigo-600 hover:text-indigo-900">Open Workspace →</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}