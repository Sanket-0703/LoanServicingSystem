@page "/users"
@attribute [Authorize(Roles = "Admin")] 
@layout MainLayout
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer

<PageTitle>User & Role Management - Loan Servicing System</PageTitle>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">System User Management</h2>
        <p class="text-sm text-slate-500 mt-1">Control platform access, provision staff accounts, and assign role-based permissions.</p>
    </div>
    <button @onclick="HandleInviteUser" class="inline-flex items-center justify-center bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
        Invite New User
    </button>
</div>

<!-- Search & Filter Bar -->
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col sm:flex-row gap-4">
    <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" @bind="SearchTerm" @bind:event="oninput"
               class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition"
               placeholder="Search users by name or email..." />
    </div>
    <div class="flex gap-4">
        <select @bind="SelectedRoleFilter" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg bg-slate-50">
            <option value="">All Roles</option>
            @foreach (var role in AvailableRoles)
            {
                <option value="@role.RoleName">@role.RoleName</option>
            }
        </select>
    </div>
</div>

<!-- Users Grid -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">User Staff</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Role</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Last Login</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200 text-sm">
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                            Loading users...
                        </td>
                    </tr>
                }
                else if (!FilteredUsers.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                            No users found matching your criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in FilteredUsers)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 rounded-full @GetAvatarColor(user.RoleName) flex items-center justify-center font-bold">
                                        @GetInitials(user.Username)
                                    </div>
                                    <div class="ml-4">
                                        <div class="font-medium text-slate-900">@user.Username</div>
                                        <div class="text-xs text-slate-500">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 text-xs font-semibold rounded-full @GetRoleBadgeColor(user.RoleName)">
                                    @user.RoleName
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (user.IsActive)
                                {
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Active</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-rose-100 text-rose-800">Disabled</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                <!-- Placeholder for Last Login as it's not in the DB schema yet -->
                                -
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                                <button @onclick="() => HandleEditRole(user.Id)" class="text-indigo-600 hover:text-indigo-900 mr-3">Edit Role</button>
                                <button @onclick="() => HandleToggleStatus(user.Id)" class="text-red-600 hover:text-red-900">
                                    @(user.IsActive ? "Disable" : "Enable")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Centered Modal for Add/Edit User -->
@if (ShowSidebar)
{
    <!-- Backdrop -->
    <div class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm transition-opacity duration-300 ease-in-out @(ShowSidebar ? "opacity-100" : "opacity-0")"></div>

    <!-- Modal Placement -->
    <div class="fixed inset-0 z-50 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">

            <!-- Modal Panel -->
            <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all duration-300 ease-in-out sm:my-8 sm:w-full sm:max-w-lg @(ShowSidebar ? "opacity-100 translate-y-0 sm:scale-100" : "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95")">

                <!-- Header -->
                <div class="flex items-center justify-between bg-slate-50 border-b border-slate-200 px-6 py-4">
                    <h3 class="text-lg font-bold text-slate-800">@(IsUpdate ? "Edit User Role" : "Invite New User")</h3>
                    <button type="button" class="rounded-full p-2 text-slate-400 hover:bg-slate-200 hover:text-slate-600 transition-colors duration-200" @onclick="CloseSidebar">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ModalErrorMessage))
                {
                    <div class="mx-6 mt-4 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg">
                        @ModalErrorMessage
                    </div>
                }

                <!-- Form Content -->
                <div class="p-6">
                    <EditForm Model="@ActiveUser" OnValidSubmit="@SaveUserAsync">
                        <!-- We remove DataAnnotationsValidator since we aren't using the DTO attributes right now -->

                        <div class="space-y-5">

                            <!-- Username (Readonly on Edit) -->
                            <div>
                                <label for="Username" class="block text-sm font-medium text-slate-700 mb-1">
                                    Username <span class="text-red-500">*</span>
                                </label>
                                <InputText id="Username" disabled="@IsUpdate"
                                           class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition disabled:opacity-60"
                                           @bind-Value="ActiveUser.Username" placeholder="e.g. jdoe" />
                            </div>

                            <!-- Email (Readonly on Edit) -->
                            <div>
                                <label for="Email" class="block text-sm font-medium text-slate-700 mb-1">
                                    Email Address <span class="text-red-500">*</span>
                                </label>
                                <InputText id="Email" disabled="@IsUpdate"
                                           class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition disabled:opacity-60"
                                           @bind-Value="ActiveUser.Email" placeholder="user@sciforn.com" />
                            </div>

                            <!-- Role Selection -->
                            <div>
                                <label for="RoleId" class="block text-sm font-medium text-slate-700 mb-1">
                                    Assigned Role <span class="text-red-500">*</span>
                                </label>
                                <InputSelect id="RoleId"
                                             class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition"
                                             @bind-Value="ActiveUser.RoleId">
                                    <option value="">Select a role...</option>
                                    @foreach (var role in AvailableRoles)
                                    {
                                        <option value="@role.Id">@role.RoleName</option>
                                    }
                                </InputSelect>
                            </div>

                            <!-- Temporary Password (Only on Add) mapped to PasswordHash -->
                            @if (!IsUpdate)
                            {
                                <div>
                                    <label for="Password" class="block text-sm font-medium text-slate-700 mb-1">
                                        Temporary Password <span class="text-red-500">*</span>
                                    </label>
                                    <InputText id="Password" type="password"
                                               class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition"
                                               @bind-Value="ActiveUser.PasswordHash" placeholder="••••••••" />
                                </div>
                            }
                        </div>
                    </EditForm>
                </div>

                <!-- Footer Actions -->
                <div class="border-t border-slate-200 bg-slate-50 px-6 py-4">
                    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                        <button type="button"
                                class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition shadow-sm"
                                @onclick="CloseSidebar">
                            Cancel
                        </button>
                        <button type="button" disabled="@IsSaving"
                                class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 transition shadow-sm"
                                @onclick="SaveUserAsync">
                            @if (IsSaving)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                <span>Save User</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}