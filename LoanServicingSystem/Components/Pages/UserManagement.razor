@page "/users"
@layout MainLayout
@* @attribute [Authorize(Roles = "Admin")] *@

<PageTitle>User & Role Management - Loan Servicing System</PageTitle>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">System User Management</h2>
        <p class="text-sm text-slate-500 mt-1">Control platform access, provision staff accounts, and assign role-based permissions.</p>
    </div>
    <button class="inline-flex items-center justify-center bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
        Invite New User
    </button>
</div>

<!-- Search & Filter Bar -->
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col sm:flex-row gap-4">
    <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition" placeholder="Search users by name or email..." />
    </div>
    <div class="flex gap-4">
        <select class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg bg-slate-50">
            <option>All Roles</option>
            <option>Admin</option>
            <option>Loan Officer</option>
            <option>Collections</option>
            <option>Read Only</option>
        </select>
    </div>
</div>

<!-- Users Grid -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">User Staff</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Role</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Last Login</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200 text-sm">
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold">SA</div>
                            <div class="ml-4">
                                <div class="font-medium text-slate-900">Sanket Admin</div>
                                <div class="text-xs text-slate-500">admin@sciforn.com</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Admin</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Active</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500">Today, 09:42 AM</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                        <button class="text-indigo-600 hover:text-indigo-900 mr-3">Edit Role</button>
                        <button class="text-red-600 hover:text-red-900">Disable</button>
                    </td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold">PS</div>
                            <div class="ml-4">
                                <div class="font-medium text-slate-900">Priya Sharma</div>
                                <div class="text-xs text-slate-500">priya.sharma@sciforn.com</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Loan Officer</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Active</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500">Yesterday, 04:15 PM</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                        <button class="text-indigo-600 hover:text-indigo-900 mr-3">Edit Role</button>
                        <button class="text-red-600 hover:text-red-900">Disable</button>
                    </td>
                </tr>
                <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="h-10 w-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-bold">RV</div>
                            <div class="ml-4">
                                <div class="font-medium text-slate-900">Rahul Verma</div>
                                <div class="text-xs text-slate-500">rahul.verma@sciforn.com</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-800">Collections</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">Active</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500">Jul 21, 2026</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                        <button class="text-indigo-600 hover:text-indigo-900 mr-3">Edit Role</button>
                        <button class="text-red-600 hover:text-red-900">Disable</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

