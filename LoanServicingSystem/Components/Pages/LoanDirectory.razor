@page "/loans"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer
@using LoanServicingSystem.Components.Shared

<PageTitle>Loan Directory - Loan Servicing System</PageTitle>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

    <div>

        <h2 class="text-3xl font-bold text-slate-800">
            Loan Directory
        </h2>

        <p class="mt-1 text-sm text-slate-500">
            Manage originated loans, monitor repayments and track loan status.
        </p>

    </div>

    <a href="/loans/new"
       class="inline-flex items-center rounded-xl bg-indigo-600 px-4 py-2.5 text-white font-medium shadow-sm hover:bg-indigo-700 transition">

        <svg class="w-5 h-5 mr-2"
             fill="none"
             stroke="currentColor"
             viewBox="0 0 24 24">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4" />

        </svg>

        Originate Loan

    </a>

</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

    <StatCard
        Title="Loans"
        Value="@TotalLoans.ToString()"
        SubTitle="Total Loans"
        IsLoading="@IsLoading">

        <Icon>🏦</Icon>

    </StatCard>

    <StatCard Title="Draft"
              Value="@DraftLoans.ToString()"
              SubTitle="Awaiting Approval"
              IsLoading="@IsLoading"
              ValueColor="text-amber-600"
              IconBackground="bg-amber-100"
              IconColor="text-amber-600">

        <Icon>📝</Icon>

    </StatCard>

    <StatCard Title="Approved"
              Value="@ApprovedLoans.ToString()"
              SubTitle="Ready for Disbursement"
              IsLoading="@IsLoading"
              ValueColor="text-blue-600"
              IconBackground="bg-blue-100"
              IconColor="text-blue-600">

        <Icon>✅</Icon>

    </StatCard>

    <StatCard Title="Disbursed"
              Value="@DisbursedLoans.ToString()"
              SubTitle="Active Loans"
              IsLoading="@IsLoading"
              ValueColor="text-emerald-600"
              IconBackground="bg-emerald-100"
              IconColor="text-emerald-600">

        <Icon>💰</Icon>

    </StatCard>

</div>

<!-- Search and Status Filter Bar -->
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col sm:flex-row gap-4">
    <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" @bind="SearchQuery" @bind:event="oninput" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition" placeholder="Search by Loan Number, Customer or Product..."  />
    </div>

    <div class="flex gap-4">
        <select @bind="SelectedStatus" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-lg bg-slate-50">
            <option value="">All Statuses</option>
            <option value="Draft">Draft</option>
            <option value="Approved">Approved</option>
            <option value="Disbursed">Disbursed</option>
            <option value="Closed">Closed</option>
            <option value="Rejected">Rejected</option>
        </select>
    </div>
</div>

<!-- Data Grid -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Loan ID / Product</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Borrower</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Principal Amount</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        Progress
                    </th>

                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        Status
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Disbursement Date</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @if (IsLoading)
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-slate-500 text-sm">
                            Loading loan directory...
                        </td>
                    </tr>
                }
                else if (!FilteredLoans.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-slate-500 text-sm">
                            No loans found matching your criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var loan in FilteredLoans)
                    {
                       <tr class="hover:bg-indigo-50 transition-all duration-200">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">

                                        🏦

                                    </div>

                                    <div>

                                        <div class="text-sm font-bold text-slate-900">

                                            @loan.LoanNumber

                                        </div>

                                        <div class="mt-1">

                                            <span class="inline-flex rounded-full bg-indigo-100 text-indigo-700 px-2 py-1 text-xs font-medium">

                                                @loan.ProductName

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-slate-900">@loan.CustomerName</div>
                                <div class="text-xs text-slate-500 font-mono">CUS- @loan.CustomerId.ToString().Substring(0, 8).ToUpper()</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="font-bold text-emerald-600 text-lg">

                                    @loan.Principal.ToString("C0")

                                </div>

                                <div class="mt-1 flex gap-2 text-xs">

                                    <span class="rounded-full bg-slate-100 px-2 py-1">

                                        @loan.Tenure Months

                                    </span>

                                    <span class="rounded-full bg-indigo-100 text-indigo-700 px-2 py-1">

                                        @loan.InterestRate.ToString("0.00")%

                                    </span>

                                </div>
                            </td>
                            <!-- Progress -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <div class="flex items-center gap-2">

                                    <div class="h-2 w-16 rounded-full
            @(loan.Status == "Draft"
                ? "bg-slate-300"
                : loan.Status == "Approved"
                    ? "bg-blue-400"
                    : loan.Status == "Disbursed"
                        ? "bg-emerald-500"
                        : "bg-purple-500")">
                                    </div>

                                    <span class="text-xs text-slate-500">

                                        @switch (loan.Status)
                                        {
                                            case "Draft":
                                                @:25%
                                                break;

                                            case "Approved":
                                                @:50%
                                                break;

                                            case "Disbursed":
                                                @:75%
                                                break;

                                            case "Closed":
                                                @:100%
                                                break;

                                            default:
                                                @:—
                                                break;
                                        }

                                    </span>

                                </div>

                            </td>

                            <!-- Status -->

                            <td class="px-6 py-4 whitespace-nowrap">

                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold @GetStatusBadgeClass(loan.Status)">

                                    @switch (loan.Status)
                                    {
                                        case "Draft":
                                            <span>📝 Draft</span>
                                            break;

                                        case "Approved":
                                            <span>✅ Approved</span>
                                            break;

                                        case "Disbursed":
                                            <span>💰 Disbursed</span>
                                            break;

                                        case "Closed":
                                            <span>✔ Closed</span>
                                            break;

                                        case "Rejected":
                                            <span>❌ Rejected</span>
                                            break;

                                        default:
                                            <span>@loan.Status</span>
                                            break;
                                    }

                                </span>

                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @(loan.StartDate.HasValue ? loan.StartDate.Value.ToString("MMM dd, yyyy") : "-")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end gap-2">

                                    <a href="/loans/@loan.Id"
                                       class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 hover:bg-slate-50 transition">

                                        👁

                                    </a>

                                    @if (loan.Status == "Draft")
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-amber-100 px-3 py-2 text-xs font-medium text-amber-700">
                                            Awaiting Approval
                                        </span>
                                    }
                                    else if (loan.Status == "Approved")
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-blue-100 px-3 py-2 text-xs font-medium text-blue-700">
                                            Ready to Disburse
                                        </span>
                                    }
                                    else if (loan.Status == "Disbursed")
                                    {
                                        <span class="inline-flex items-center rounded-lg bg-emerald-100 px-3 py-2 text-xs font-medium text-emerald-700">
                                            Active
                                        </span>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>