@page "/unauthorized"

<PageTitle>Access Denied - Loan Servicing System</PageTitle>

<div class="min-h-screen bg-slate-50 flex flex-col justify-center items-center py-12 px-4 sm:px-6 lg:px-8">

    <!-- Lock Icon Container -->
    <div class="h-24 w-24 bg-red-50 border border-red-100 text-red-500 rounded-full flex items-center justify-center mb-6 shadow-sm">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
    </div>

    <!-- Error Text -->
    <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Access Denied
    </h1>

    <p class="text-base text-slate-600 mb-8 text-center max-w-md">
        You do not have the required role permissions to view this page or perform this action. If you believe this is a mistake, please reach out to your system administrator.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href="/dashboard" class="flex justify-center px-6 py-2.5 rounded-lg font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition shadow-sm">
            Return to Dashboard
        </a>

        <button type="button" class="flex justify-center px-6 py-2.5 rounded-lg font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition shadow-sm">
            Contact Admin
        </button>
    </div>

    <!-- Error Code Footer -->
    <div class="mt-12 text-sm text-slate-400 font-mono">
        Error Code: 403_FORBIDDEN
    </div>

</div>

@code {
    // Later, when you implement Blazor's built-in AuthenticationStateProvider,
    // this page will automatically be shown by the <AuthorizeRouteView> component
    // whenever a user fails a role check (e.g., [Authorize(Roles = "Admin")]).
}