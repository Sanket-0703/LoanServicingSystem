@page "/loans/new"
@layout MainLayout

<PageTitle>Originate Loan - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/loans" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Originate New Loan</h2>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Configure loan terms, select borrower profile, and establish product templates.</p>
    </div>
</div>

<!-- Wizard Container -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden max-w-4xl mx-auto">

    <!-- Progress Header -->
    <div class="bg-slate-50 px-8 py-4 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center space-x-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-sm">1</span>
            <span class="text-sm font-semibold text-slate-800">Select Customer & Product</span>
        </div>
        <div class="h-0.5 w-12 bg-slate-300"></div>
        <div class="flex items-center space-x-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-200 text-slate-600 font-bold text-sm">2</span>
            <span class="text-sm font-medium text-slate-500">Terms & Schedule</span>
        </div>
        <div class="h-0.5 w-12 bg-slate-300"></div>
        <div class="flex items-center space-x-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-200 text-slate-600 font-bold text-sm">3</span>
            <span class="text-sm font-medium text-slate-500">Review & Submit</span>
        </div>
    </div>

    <!-- Form Content -->
    <div class="p-8 space-y-6">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Select Borrower</label>
                <select class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                    <option value="">Choose registered customer...</option>
                    <option value="1">Aarav Patel (CUST-8273)</option>
                    <option value="2">Meera Reddy (CUST-9124)</option>
                    <option value="3">Vikram Singh (CUST-3341)</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Loan Product Template</label>
                <select class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                    <option value="">Choose template...</option>
                    <option value="1">Personal Loan - Tier 1 (12.5% / yr)</option>
                    <option value="2">Vehicle Loan (Used) (9.5% / yr)</option>
                    <option value="3">Micro-Business Advance (15.0% / yr)</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Principal Amount ($)</label>
                <input type="number" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" placeholder="10000" />
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tenure (Months)</label>
                <input type="number" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" placeholder="36" />
            </div>
        </div>

        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-4 text-indigo-900 text-sm flex items-start gap-3">
            <svg class="w-5 h-5 text-indigo-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
                <span class="font-semibold">Automated Amortization Preview:</span> Once principal and tenure are specified, the system will calculate the monthly EMI schedule prior to final draft submission.
            </div>
        </div>

    </div>

    <!-- Wizard Footer Actions -->
    <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex justify-between items-center">
        <a href="/loans" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition">
            Cancel
        </a>
        <button type="button" class="px-6 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition shadow-sm">
            Next: Calculate Schedule &rarr;
        </button>
    </div>

</div>