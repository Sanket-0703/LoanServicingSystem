@page "/loans/new"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer

<PageTitle>Originate Loan - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/loans" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Originate New Loan</h2>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Configure loan terms, select borrower profile, and establish product templates.</p>
    </div>
</div>

@if (IsLoading)
{
    <div class="text-center py-12 text-slate-500">Loading origination workspace...</div>
}
else
{
    <EditForm Model="@NewLoan" OnValidSubmit="@SubmitLoanAsync">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl shadow-sm max-w-4xl mx-auto">
                @ErrorMessage
            </div>
        }

        <!-- Wizard Container -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden max-w-6xl mx-auto">

            <!-- Progress Header -->
            <div class="bg-slate-50 px-8 py-6 border-b border-slate-200">

                <div class="flex items-center justify-between">

                    <!-- STEP 1 -->

                    <div class="flex flex-col items-center flex-1">

                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all
                @(CurrentStep == 1
                    ? "bg-indigo-600 text-white"
                    : CurrentStep > 1
                        ? "bg-emerald-500 text-white"
                        : "bg-slate-200 text-slate-500")">

                            @(CurrentStep > 1 ? "✓" : "1")

                        </div>

                        <p class="mt-3 text-sm font-semibold
                @(CurrentStep == 1
                    ? "text-indigo-600"
                    : "text-slate-600")">

                            Select Customer

                        </p>

                    </div>

                    <div class="flex-1 h-1 mx-3 rounded
            @(CurrentStep > 1
                ? "bg-emerald-500"
                : "bg-slate-200")">
                    </div>

                    <!-- STEP 2 -->

                    <div class="flex flex-col items-center flex-1">

                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all
                @(CurrentStep == 2
                    ? "bg-indigo-600 text-white"
                    : CurrentStep > 2
                        ? "bg-emerald-500 text-white"
                        : "bg-slate-200 text-slate-500")">

                            @(CurrentStep > 2 ? "✓" : "2")

                        </div>

                        <p class="mt-3 text-sm font-semibold
                @(CurrentStep == 2
                    ? "text-indigo-600"
                    : "text-slate-600")">

                            Loan Details

                        </p>

                    </div>

                    <div class="flex-1 h-1 mx-3 rounded
            @(CurrentStep > 2
                ? "bg-emerald-500"
                : "bg-slate-200")">
                    </div>

                    <!-- STEP 3 -->

                    <div class="flex flex-col items-center flex-1">

                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all
                @(CurrentStep == 3
                    ? "bg-indigo-600 text-white"
                    : "bg-slate-200 text-slate-500")">

                            3

                        </div>

                        <p class="mt-3 text-sm font-semibold
                @(CurrentStep == 3
                    ? "text-indigo-600"
                    : "text-slate-600")">

                            Review & Submit

                        </p>

                    </div>

                </div>

            </div>

            <!-- Form Content -->

            <div class="p-8">

                @* ========================================= *@
                @* STEP 1                                   *@
                @* ========================================= *@

                @if (CurrentStep == 1)
                {
                    <div class="space-y-8">

                        <div>

                            <h3 class="text-xl font-bold text-slate-800">
                                Select Borrower & Loan Product
                            </h3>

                            <p class="text-slate-500 mt-1">
                                Choose the customer and loan template before continuing.
                            </p>

                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Borrower

                                </label>

                                <InputSelect @bind-Value="NewLoan.CustomerId"
                                             class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50">

                                    <option value="@Guid.Empty">
                                        Choose customer...
                                    </option>

                                    @foreach (var customer in Customers)
                                    {
                                        <option value="@customer.Id">

                                            @customer.Name

                                        </option>
                                    }

                                </InputSelect>

                            </div>

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Loan Product

                                </label>

                                <select @onchange="OnProductChanged"
                                        class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50">

                                    <option value="">
                                        Choose product...
                                    </option>

                                    @foreach (var product in LoanProducts)
                                    {
                                        <option value="@product.Id">

                                            @product.Name

                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                        @if (SelectedCustomer != null || SelectedProduct != null)
                        {
                            <div class="grid lg:grid-cols-2 gap-6">

                                @if (SelectedCustomer != null)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">

                                        <h4 class="font-semibold mb-4">

                                            Borrower Summary

                                        </h4>

                                        <div class="space-y-3">

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Name
                                                </p>

                                                <p class="font-semibold">

                                                    @SelectedCustomer.Name

                                                </p>

                                            </div>

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Phone
                                                </p>

                                                <p>

                                                    @SelectedCustomer.Phone

                                                </p>

                                            </div>

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Credit Score
                                                </p>

                                                <p>

                                                    @SelectedCustomer.CreditScore

                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                }

                                @if (SelectedProduct != null)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">

                                        <h4 class="font-semibold mb-4">

                                            Product Summary

                                        </h4>

                                        <div class="space-y-3">

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Interest Rate
                                                </p>

                                                <p class="font-semibold text-indigo-600">

                                                    @SelectedProduct.InterestRate %

                                                </p>

                                            </div>

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Processing Fee
                                                </p>

                                                <p class="font-semibold">

                                                    @SelectedProduct.ProcessingFee?.ToString("C")

                                                </p>

                                            </div>

                                            <div>

                                                <p class="text-xs text-slate-500">
                                                    Maximum Tenure
                                                </p>

                                                <p class="font-semibold">

                                                    @SelectedProduct.TenureMonths Months

                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

                @* ========================================= *@
                @* STEP 2 PLACEHOLDER                        *@
                @* ========================================= *@

                @if (CurrentStep == 2)
                {
                    <div class="space-y-8">

                        <div>

                            <h3 class="text-xl font-bold text-slate-800">
                                Configure Loan
                            </h3>

                            <p class="text-slate-500 mt-1">
                                Define loan amount and repayment configuration.
                            </p>

                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                            <!-- Requested Amount -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Requested Loan Amount

                                </label>

                                <InputNumber @bind-Value="NewLoan.Principal"
                                             class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50" />

                            </div>

                            <!-- Tenure -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Tenure (Months)

                                </label>

                                <InputNumber @bind-Value="NewLoan.Tenure"
                                             class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50" />

                            </div>

                            <!-- Interest -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Interest Rate

                                </label>

                                <input readonly
                                       value="@($"{NewLoan.InterestRate:0.00}%")"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-100" />

                            </div>

                            <!-- Processing Fee -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Processing Fee

                                </label>

                                <input readonly
                                       value="@(SelectedProduct?.ProcessingFee?.ToString("C") ?? "-")"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-100" />

                            </div>

                            <!-- Repayment -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Repayment Frequency

                                </label>

                                <InputSelect @bind-Value="NewLoan.RepaymentFrequency"
                                             class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50">

                                    <option>Monthly</option>
                                    <option>Quarterly</option>
                                    <option>Half-Yearly</option>
                                    <option>Yearly</option>

                                </InputSelect>

                            </div>

                            <!-- Start Date -->

                            <div>

                                <label class="block text-sm font-medium text-slate-700 mb-2">

                                    Start Date

                                </label>

                                <InputDate @bind-Value="NewLoan.StartDate"
                                           class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50" />

                            </div>

                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

                            <div class="bg-slate-50 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    Interest
                                </p>

                                <p class="text-2xl font-bold text-indigo-600">

                                    @NewLoan.InterestRate%

                                </p>

                            </div>

                            <div class="bg-slate-50 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    Processing Fee
                                </p>

                                <p class="text-xl font-bold text-amber-600">

                                    @(SelectedProduct?.ProcessingFee?.ToString("C") ?? "-")

                                </p>

                            </div>

                            <div class="bg-slate-50 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    Repayment
                                </p>

                                <p class="text-xl font-bold text-emerald-600">

                                    @NewLoan.RepaymentFrequency

                                </p>

                            </div>

                            <div class="bg-slate-50 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    Estimated End Date
                                </p>

                                <p class="text-lg font-semibold">

                                    @(NewLoan.StartDate?.AddMonths(NewLoan.Tenure).ToString("dd MMM yyyy"))

                                </p>

                            </div>

                        </div>

                    </div>
                }

                @* ========================================= *@
                @* STEP 3 PLACEHOLDER                        *@
                @* ========================================= *@

                @if (CurrentStep == 3)
                {
                    <div class="space-y-8">

                        <div>

                            <h3 class="text-xl font-bold text-slate-800">
                                Review Loan Application
                            </h3>

                            <p class="text-slate-500 mt-1">
                                Verify all information before originating the loan.
                            </p>

                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                            <!-- Borrower -->

                            <div class="bg-white border border-slate-200 rounded-xl p-6">

                                <h4 class="font-semibold text-slate-800 mb-5">

                                    Borrower

                                </h4>

                                <div class="space-y-4">

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Customer

                                        </p>

                                        <p class="font-semibold">

                                            @(SelectedCustomer?.Name ?? "-")

                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Phone

                                        </p>

                                        <p>

                                            @(SelectedCustomer?.Phone ?? "-")

                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Credit Score

                                        </p>

                                        <p>

                                            @(SelectedCustomer?.CreditScore.ToString() ?? "-")

                                        </p>

                                    </div>

                                </div>

                            </div>

                            <!-- Product -->

                            <div class="bg-white border border-slate-200 rounded-xl p-6">

                                <h4 class="font-semibold text-slate-800 mb-5">

                                    Loan Product

                                </h4>

                                <div class="space-y-4">

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Product

                                        </p>

                                        <p class="font-semibold">

                                            @(SelectedProduct?.Name ?? "-")

                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Interest Rate

                                        </p>

                                        <p>

                                            @NewLoan.InterestRate %

                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs text-slate-500">

                                            Processing Fee

                                        </p>

                                        <p>

                                            @(SelectedProduct?.ProcessingFee?.ToString("C") ?? "-")

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Loan Summary -->

                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">

                            <h4 class="font-semibold text-slate-800 mb-6">

                                Loan Summary

                            </h4>

                            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Principal

                                    </p>

                                    <p class="text-xl font-bold text-emerald-600">

                                        @NewLoan.Principal.ToString("C")

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Tenure

                                    </p>

                                    <p class="text-xl font-bold">

                                        @NewLoan.Tenure Months

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Repayment

                                    </p>

                                    <p class="text-xl font-bold">

                                        @NewLoan.RepaymentFrequency

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Status

                                    </p>

                                    <span class="inline-flex px-3 py-1 rounded-full bg-amber-100 text-amber-700 font-semibold">

                                        Draft

                                    </span>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Start Date

                                    </p>

                                    <p>

                                        @NewLoan.StartDate?.ToString("dd MMM yyyy")

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Estimated End Date

                                    </p>

                                    <p>

                                        @NewLoan.StartDate?.AddMonths(NewLoan.Tenure).ToString("dd MMM yyyy")

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Loan Number

                                    </p>

                                    <p class="text-slate-500">

                                        Auto Generated

                                    </p>

                                </div>

                                <div>

                                    <p class="text-xs text-slate-500">

                                        Schedule

                                    </p>

                                    <p class="text-emerald-600 font-semibold">

                                        Auto Generated

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
            <!-- Wizard Footer Actions -->
            <!-- Wizard Footer -->

            <div class="bg-slate-50 px-8 py-5 border-t border-slate-200 flex items-center justify-between">

                @* STEP 1 *@

                @if (CurrentStep == 1)
                {
                    <a href="/loans"
                       class="px-5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">

                        Cancel

                    </a>

                    <button type="button"
                            @onclick="NextStep"
                            class="px-6 py-2.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition">

                        Next →

                    </button>
                }

                @* STEP 2 *@

                @if (CurrentStep == 2)
                {
                    <button type="button"
                            @onclick="PreviousStep"
                            class="px-5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">

                        ← Previous

                    </button>

                    <button type="button"
                            @onclick="NextStep"
                            class="px-6 py-2.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition">

                        Next →

                    </button>
                }

                @* STEP 3 *@

                @if (CurrentStep == 3)
                {
                    <button type="button"
                            @onclick="PreviousStep"
                            class="px-5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">

                        ← Previous

                    </button>

                    <button type="submit"
                            disabled="@IsSaving"
                            class="px-6 py-2.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 disabled:opacity-50 transition">

                        @if (IsSaving)
                        {
                            <span>Originating...</span>
                        }
                        else
                        {
                            <span>Originate Loan</span>
                        }

                    </button>
                }

            </div>

        </div>
    </EditForm>
}