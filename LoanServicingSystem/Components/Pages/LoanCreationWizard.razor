@page "/loans/new"
@layout MainLayout
@attribute [Authorize]
@namespace LoanServicingSystem.Components.Pages
@rendermode InteractiveServer

<PageTitle>Originate Loan - Loan Servicing System</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/loans" class="text-slate-400 hover:text-slate-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            </a>
            <h2 class="text-2xl font-bold text-slate-800">Originate New Loan</h2>
        </div>
        <p class="text-sm text-slate-500 mt-1 ml-8">Configure loan terms, select borrower profile, and establish product templates.</p>
    </div>
</div>

@if (IsLoading)
{
    <div class="text-center py-12 text-slate-500">Loading origination workspace...</div>
}
else
{
    <EditForm Model="@NewLoan" OnValidSubmit="@SubmitLoanAsync">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl shadow-sm max-w-4xl mx-auto">
                @ErrorMessage
            </div>
        }

        <!-- Wizard Container -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden max-w-4xl mx-auto">

            <!-- Progress Header -->
            <div class="bg-slate-50 px-8 py-4 border-b border-slate-200 flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-sm">1</span>
                    <span class="text-sm font-semibold text-slate-800">Select Customer & Product</span>
                </div>
                <div class="h-0.5 w-12 bg-slate-300"></div>
                <div class="flex items-center space-x-4">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-sm">2</span>
                    <span class="text-sm font-semibold text-slate-800">Terms & Schedule</span>
                </div>
                <div class="h-0.5 w-12 bg-slate-300"></div>
                <div class="flex items-center space-x-4">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white font-bold text-sm">3</span>
                    <span class="text-sm font-semibold text-slate-800">Review & Submit</span>
                </div>
            </div>

            <!-- Form Content -->
            <div class="p-8 space-y-6">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Select Borrower <span class="text-red-500">*</span></label>
                        <InputSelect @bind-Value="NewLoan.CustomerId" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                            <option value="@Guid.Empty">Choose registered customer...</option>
                            @foreach (var customer in Customers)
                            {
                                <option value="@customer.Id">@customer.Name (@customer.Id.ToString().Substring(0, 8).ToUpper())</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Loan Product Template <span class="text-red-500">*</span></label>
                        <select @onchange="OnProductChanged" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                            <option value="">Choose template...</option>
                            @foreach (var product in LoanProducts)
                            {
                                <option value="@product.Id">@product.Name (@product.InterestRate.ToString("0.00")% / yr)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Principal Amount ($) <span class="text-red-500">*</span></label>
                        <InputNumber @bind-Value="NewLoan.Principal" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Tenure (Months) <span class="text-red-500">*</span></label>
                        <InputNumber @bind-Value="NewLoan.Tenure" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition" />
                    </div>
                </div>

                <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-4 text-indigo-900 text-sm flex items-start gap-3">
                    <svg class="w-5 h-5 text-indigo-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>
                        <span class="font-semibold">Automated Amortization Preview:</span> Submitting this form will record the loan as a draft and auto-generate the full monthly EMI repayment schedule.
                    </div>
                </div>

            </div>

            <!-- Wizard Footer Actions -->
            <div class="bg-slate-50 px-8 py-4 border-t border-slate-200 flex justify-between items-center">
                <a href="/loans" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit" disabled="@IsSaving" class="px-6 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 disabled:opacity-50 transition shadow-sm flex items-center">
                    @if (IsSaving)
                    {
                        <span>Originating...</span>
                    }
                    else
                    {
                        <span>Save & Generate Schedule &rarr;</span>
                    }
                </button>
            </div>

        </div>
    </EditForm>
}