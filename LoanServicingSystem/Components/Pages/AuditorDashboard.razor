@namespace LoanServicingSystem.Components.Pages
@using LoanServicingSystem.Components.Shared

<div class="space-y-5">

    <!-- ========================================= -->
    <!-- Dashboard Header -->
    <!-- ========================================= -->

    <DashboardHeader />

    <!-- ========================================= -->
    <!-- KPI Cards -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

        <StatCard IsLoading="@IsLoading"
                  Title="Total Loans"
                  Value="@Dashboard.TotalLoans.ToString()"
                  SubTitle="Loan Portfolio">
            <Icon>🏦</Icon>
        </StatCard>

        <StatCard IsLoading="@IsLoading"
                  Title="Active Loans"
                  Value="@Dashboard.ActiveLoans.ToString()"
                  SubTitle="Currently Active">
            <Icon>✅</Icon>
        </StatCard>

        <StatCard IsLoading="@IsLoading"
                  Title="Collections"
                  Value="@Dashboard.TotalCollections.ToString("C0")"
                  SubTitle="Total Collected">
            <Icon>💰</Icon>
        </StatCard>

        <StatCard IsLoading="@IsLoading"
                  Title="Audit Records"
                  Value="@Dashboard.AuditRecordCount.ToString()"
                  SubTitle="Recorded Changes">
            <Icon>📋</Icon>
        </StatCard>

    </div>

    <!-- ========================================= -->
    <!-- Dashboard Charts -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">

        <LoanStatusChart Data="Dashboard.LoanStatus" />

        <CollectionTrendChart Data="Dashboard.CollectionTrend" />

    </div>

    <!-- ========================================= -->
    <!-- Recent Audit Logs -->
    <!-- ========================================= -->

    <AuditTrailTable Title="Recent Audit Logs"
                     Logs="Dashboard.RecentAuditLogs" />

    <!-- ========================================= -->
    <!-- Recent Loans -->
    <!-- ========================================= -->

    <RecentLoansTable Title="Recent Loans"
                      Loans="Dashboard.RecentLoans" />

</div>