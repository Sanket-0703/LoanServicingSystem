@namespace LoanServicingSystem.Components.Pages
@using LoanServicingSystem.Components.Shared


<div class="p-4 md:p-6 bg-slate-50 min-h-screen space-y-6 text-slate-800">

    <!-- ========================================= -->
    <!-- Dashboard Header -->
    <!-- ========================================= -->

    <DashboardHeader OnRefresh="ReloadDashboard"
                     Title="Administrator" />

    <!-- ========================================= -->
    <!-- Main Dashboard Grid -->
    <!-- ========================================= -->

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- ========================================= -->
        <!-- Left Section -->
        <!-- ========================================= -->

        <div class="md:col-span-2 flex flex-col gap-6">

            <!-- KPI Cards -->
            <div class="grid grid-cols-2 gap-4">

                <StatCard IsLoading="@IsLoading"
                          Title="ACTIVE LOANS"
                          Value="@Dashboard.ActiveLoanCount.ToString()"
                          SubTitle="Currently Active">
                    <Icon>
                        <div class="p-2 bg-blue-50 text-blue-500 rounded text-xl">💼</div>
                    </Icon>
                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="PORTFOLIO"
                          Value="@Dashboard.TotalPortfolio.ToString("C0")"
                          SubTitle="Outstanding Principal">
                    <Icon>
                        <div class="p-2 bg-blue-50 text-blue-500 rounded text-xl">₹</div>
                    </Icon>
                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="CUSTOMERS"
                          Value="@Dashboard.CustomerCount.ToString()"
                          SubTitle="Registered Customers">
                    <Icon>
                        <div class="p-2 bg-blue-50 text-blue-500 rounded text-xl">👥</div>
                    </Icon>
                </StatCard>

                <StatCard IsLoading="@IsLoading"
                          Title="COLLECTIONS TODAY"
                          Value="@Dashboard.CollectionsToday.ToString("C0")"
                          SubTitle="Today's Collection">
                    <Icon>
                        <div class="p-2 bg-blue-50 text-blue-500 rounded text-xl">📈</div>
                    </Icon>
                </StatCard>

            </div>

            <!-- Portfolio Summary -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 w-full">
                <PortfolioSummary Model="Dashboard.Portfolio" />
            </div>

            <!-- Quick Actions -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 w-full">
                <QuickActions Actions="QuickActionsList" />
            </div>

        </div>

        <!-- ========================================= -->
        <!-- Right Section -->
        <!-- ========================================= -->

        <div class="md:col-span-1 flex flex-col gap-6">

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 h-full flex flex-col gap-6">

                <!-- Collection Trend -->
                <div class="flex-1">

                    <div class="flex flex-col w-full h-full">

                        <div class="flex-grow relative w-full h-full">
                            <CollectionTrendChart Data="Dashboard.CollectionTrend" />
                        </div>

                    </div>

                </div>

                <!-- Loan Status Distribution -->
                <div class="flex-1">

                    <div class="flex flex-col items-center w-full h-full">

                        <div class="flex-grow relative w-full h-full">
                            <LoanStatusChart Data="Dashboard.LoanStatus" />
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================= -->
    <!-- Recent Activity -->
    <!-- ========================================= -->

    <div class="flex flex-col gap-6 pt-2">

        <!-- Recent Loan Applications -->

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 w-full overflow-x-auto">

            <h3 class="text-sm font-semibold text-slate-800 mb-4">
                Recent Loan Applications
            </h3>

            <RecentLoansTable Loans="Dashboard.RecentLoans" />

        </div>

        <!-- Recent Payments -->

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 w-full overflow-x-auto">

            <h3 class="text-sm font-semibold text-slate-800 mb-4">
                Recent Payments
            </h3>

            <RecentPaymentsTable Payments="Dashboard.RecentPayments" />

        </div>

    </div>

</div>