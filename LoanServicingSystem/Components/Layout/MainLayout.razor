@inherits LayoutComponentBase
@using System.Linq
@using System.Security.Claims

<div class="p-4"
     @onclick="CloseProfileMenu">

    <!-- ========================================= -->
    <!-- NAVIGATION -->
    <!-- ========================================= -->

    <header class="pt-6">

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <nav class="bg-white/80 backdrop-blur-md border border-slate-200/60 shadow-sm rounded-2xl px-6 py-3 flex items-center justify-between sticky top-6 z-50">

                <!-- Brand -->
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-200">
                        LS
                    </div>

                    <span class="text-xl font-bold text-slate-800 tracking-tight hidden sm:block">
                        Loan System
                    </span>
                </div>

                <CascadingAuthenticationState>

                    <div class="hidden md:flex items-center gap-1 bg-slate-100/50 p-1 rounded-xl border border-slate-200/50">

                        <NavLink href="/dashboard"
                                 class="px-4 py-2 bg-white text-indigo-600 rounded-lg text-sm font-semibold shadow-sm border border-slate-200/50 transition-all"
                                 ActiveClass="bg-white text-indigo-600">
                            Dashboard
                        </NavLink>

                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <NavLink href="/users"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Users
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,LoanOfficer,Auditor">
                            <Authorized>
                                <NavLink href="/loans"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Loans
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,LoanOfficer,CollectionsAgent">
                            <Authorized>
                                <NavLink href="/customers"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Customers
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,LoanOfficer,Auditor">
                            <Authorized>
                                <NavLink href="/statements"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Statements
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,CollectionsAgent">
                            <Authorized>
                                <NavLink href="/collections"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Collections
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Auditor">
                            <Authorized>
                                <NavLink href="/reports"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Reports
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin,Auditor">
                            <Authorized>
                                <NavLink href="/audit-trail"
                                         class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                                    Audit Trail
                                </NavLink>
                            </Authorized>
                        </AuthorizeView>

                    </div>

                </CascadingAuthenticationState>

                <!-- Right Side -->

                <div class="flex items-center gap-4">

                    <button class="relative p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-full transition-colors">

                        <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>

                        <svg class="w-6 h-6"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />

                        </svg>

                    </button>

                    <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

                    <ProfileMenu />

                </div>

            </nav>

        </div>

    </header>

    <!-- ========================================= -->
    <!-- PAGE CONTENT -->
    <!-- ========================================= -->

    <main class="mt-8">

        <div class="animate-in fade-in slide-in-from-bottom-4 duration-500">

            @Body

        </div>

    </main>

</div>

@code {

    private bool showProfileMenu;

    private void ToggleProfileMenu()
    {
        showProfileMenu = !showProfileMenu;
    }

    private void CloseProfileMenu()
    {
        showProfileMenu = false;
    }

}