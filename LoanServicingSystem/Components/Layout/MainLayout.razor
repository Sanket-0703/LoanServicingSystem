@inherits LayoutComponentBase

<div class="min-h-screen bg-[#f8fafc] font-sans selection:bg-indigo-100 selection:text-indigo-900 pb-12">

    <!-- Floating Island Navigation -->
    <div class="pt-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <nav class="bg-white/80 backdrop-blur-md border border-slate-200/60 shadow-sm rounded-2xl px-6 py-3 flex items-center justify-between sticky top-6 z-50">

            <!-- Brand -->
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-200">
                    LS
                </div>
                <span class="text-xl font-bold text-slate-800 tracking-tight hidden sm:block">Loan System</span>
            </div>

            <!-- Center Navigation Links -->
            <div class="hidden md:flex items-center gap-1 bg-slate-100/50 p-1 rounded-xl border border-slate-200/50">

                <!-- Active Link Style -->
                <a href="/dashboard" class="px-4 py-2 bg-white text-indigo-600 rounded-lg text-sm font-semibold shadow-sm border border-slate-200/50 transition-all">
                    Dashboard
                </a>

                <!-- Inactive Link Style -->
                <a href="/users" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                    Users
                </a>

                <a href="/loans" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                    Loans
                </a>

                <a href="/customers" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-200/50 rounded-lg text-sm font-medium transition-all">
                    Customers
                </a>
                <a href="/statements" class="text-slate-500 hover:text-slate-900 px-3 py-2 rounded-md text-sm font-medium transition">
                    Statements
                </a>
                <a href="/collections" class="text-slate-500 hover:text-slate-900 px-3 py-2 rounded-md text-sm font-medium transition">
                    Collections
                </a>
                <a href="/reports" class="text-slate-500 hover:text-slate-900 px-3 py-2 rounded-md text-sm font-medium transition">
                    Reports
                </a>
                <a href="/audit-trail" class="text-slate-500 hover:text-slate-900 px-3 py-2 rounded-md text-sm font-medium transition flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    Audit Trail
                </a>
            </div>

            <!-- Right Actions & Profile -->
            <div class="flex items-center gap-4">

                <!-- Notifications Button -->
                <button class="relative p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-full transition-colors">
                    <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </button>

                <!-- Divider -->
                <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

                <!-- User Profile Dropdown Trigger -->
                <button class="flex items-center gap-3 text-left group">
                    <div class="hidden sm:block">
                        <p class="text-sm font-bold text-slate-700 group-hover:text-indigo-600 transition-colors">Admin User</p>
                        <p class="text-xs text-slate-500 font-medium">View Profile</p>
                    </div>
                    <div class="h-10 w-10 rounded-full bg-indigo-100 border border-indigo-200 flex items-center justify-center text-indigo-700 font-bold shadow-sm group-hover:ring-2 group-hover:ring-indigo-500 group-hover:ring-offset-2 transition-all">
                        A
                    </div>
                </button>

            </div>
        </nav>
    </div>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <!-- Render the page content inside a subtle wrapper -->
        <div class="animate-in fade-in slide-in-from-bottom-4 duration-500">
            @Body
        </div>
    </main>

</div>