@namespace LoanServicingSystem.Components.Shared

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">

        <div>

            <h2 class="text-lg font-semibold text-slate-800">
                Recent Payments
            </h2>

            <p class="text-sm text-slate-500">
                Latest customer repayments
            </p>

        </div>

        <NavLink href="/statements"
                 class="text-indigo-600 hover:text-indigo-700 text-sm font-medium">

            View All →

        </NavLink>

    </div>

    <table class="w-full">

        <thead class="bg-slate-50">

            <tr>

                <th class="px-6 py-3 text-left text-xs font-semibold uppercase">
                    Loan
                </th>

                <th class="px-6 py-3 text-left text-xs font-semibold uppercase">
                    Customer
                </th>

                <th class="px-6 py-3 text-right text-xs font-semibold uppercase">
                    Amount
                </th>

                <th class="px-6 py-3 text-center text-xs font-semibold uppercase">
                    Mode
                </th>

                <th class="px-6 py-3 text-center text-xs font-semibold uppercase">
                    Date
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var payment in Payments)
            {
                <tr class="border-t hover:bg-slate-50">

                    <td class="px-6 py-4">@payment.LoanNumber</td>

                    <td class="px-6 py-4">@payment.CustomerName</td>

                    <td class="px-6 py-4 text-right font-semibold">
                        @payment.Amount.ToString("C0")
                    </td>

                    <td class="px-6 py-4 text-center">
                        @payment.PaymentMode
                    </td>

                    <td class="px-6 py-4 text-center">
                        @payment.PaymentDate.ToString("dd MMM yyyy")
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>