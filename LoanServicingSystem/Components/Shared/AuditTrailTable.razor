@namespace LoanServicingSystem.Components.Shared
@using CoreData.Dashboard.Models

<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4">

    <div class="flex items-center justify-between mb-4">

        <h2 class="text-lg font-semibold text-slate-800">
            @Title
        </h2>

    </div>

    <div class="overflow-x-auto">

        <table class="min-w-full">

            <thead>

                <tr class="border-b border-slate-200">

                    <th class="text-left py-3 px-3 text-sm font-semibold text-slate-600">
                        Date
                    </th>

                    <th class="text-left py-3 px-3 text-sm font-semibold text-slate-600">
                        User
                    </th>

                    <th class="text-left py-3 px-3 text-sm font-semibold text-slate-600">
                        Module
                    </th>

                    <th class="text-left py-3 px-3 text-sm font-semibold text-slate-600">
                        Action
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Logs.Any())
                {
                    @foreach (var log in Logs)
                    {
                        <tr class="border-b border-slate-100 hover:bg-slate-50">

                            <td class="py-3 px-3 text-sm text-slate-700">
                                @log.ChangedOn.ToString("dd MMM yyyy")
                            </td>

                            <td class="py-3 px-3 text-sm text-slate-700">
                                @log.ChangedBy
                            </td>

                            <td class="py-3 px-3">

                                <span class="px-2 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-medium">

                                    @log.Module

                                </span>

                            </td>

                            <td class="py-3 px-3 text-sm font-medium text-slate-800">

                                @log.ChangeType

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="4"
                            class="py-8 text-center text-slate-400">

                            No audit records found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>