@namespace LoanServicingSystem.Components.Shared

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">

    <div class="p-6">

        <div class="flex justify-between items-start">

            <div class="flex-1">

                <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">
                    @Title
                </p>

                @if (IsLoading)
                {
                    <div class="mt-4 h-10 w-28 bg-slate-200 rounded animate-pulse"></div>
                }
                else
                {
                    <h2 class="mt-3 text-3xl font-bold @ValueColor">
                        @Value
                    </h2>
                }

                @if (!string.IsNullOrWhiteSpace(SubTitle))
                {
                    <p class="mt-2 text-sm text-slate-500">
                        @SubTitle
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Trend))
                {
                    <div class="mt-3 inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold @TrendBackground @TrendColor">

                        @Trend

                    </div>
                }

            </div>

            <div class="rounded-xl p-3 @IconBackground">

                <div class="@IconColor text-xl flex items-center justify-center">

                    @Icon

                </div>

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(FooterText))
    {
        <button class="w-full border-t border-slate-100 px-6 py-3 text-left hover:bg-slate-50 transition"
                @onclick="HandleClick">

            <div class="flex justify-between items-center">

                <span class="text-sm font-medium text-slate-600">

                    @FooterText

                </span>

                <svg class="w-4 h-4 text-slate-400"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5l7 7-7 7" />

                </svg>

            </div>

        </button>
    }

</div>