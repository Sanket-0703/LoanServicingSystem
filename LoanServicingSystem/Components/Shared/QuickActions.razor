@namespace LoanServicingSystem.Components.Shared

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">

    <h2 class="text-lg font-bold text-slate-800 mb-6">
        Quick Actions
    </h2>

    <div class="grid grid-cols-2 gap-4">

        @foreach (var action in Actions)
        {
            <NavLink href="@action.Url"
                     class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50 transition">

                <div class="@action.BackgroundColor w-12 h-12 rounded-xl flex items-center justify-center text-2xl">

                    @action.Icon

                </div>

                <div>

                    <h3 class="font-semibold text-slate-800">

                        @action.Title

                    </h3>

                    <p class="text-sm text-slate-500">

                        @action.Description

                    </p>

                </div>

            </NavLink>
        }

    </div>

</div>